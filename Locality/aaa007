isa_state:
  version: "2.5-handover"
  updated: "2026-11-25"
  target_era: "1981-1983 NMOS Custom SoC + Fast/ALS TTL"
  package_target: "40-pin PDIP (CPU & ULA/VDP)"

  clocks:
    master_osc_mhz: 14.18758
    quarter_t_ns: 70.484        # 1Q = 1 / 14.18758 MHz (DDS_L / DDS_H beat width = 35.24 ns half-Q)
    half_t_ns: 140.968          # 1H = 0.5T (Phi1 / Phi2)
    cpu_t_mhz: 3.546895
    cpu_t_ns: 281.936           # 1T = 4Q
    vdp_pixel_mhz: 7.09379      # Primary 320px TV/composite pixel clock (140.97 ns/px)
    vdp_hires_mhz: 14.18758     # High-res 640px RGB SCART / BURST_DIS pixel clock (70.48 ns/px)
    pal_scanline_t: 227.0       # 160T active (45.11 us) + 24.5T border + 42.5T H-blank
    pal_field_lines: 312.5      # 50 Hz interlaced PAL (288 visible lines/field, 240 safe-area active)

  zx48k_platform:
    bom_wholesale_usd:
      single_cpu_isa1: "38.27 - 56.70"
      dual_cpu_with_z80a_slave: "41.77 - 61.70"
    retail_target_usd:
      single_cpu_isa1: "115 - 165"
      dual_cpu_with_z80a_slave: "123 - 175"
    crossbar_retail_bump_usd: "+4.15 to +6.60 gross (offset by -1 DRAM ADDR_BUF IC and optional single-CPU build)"

  hw_invariants:
    zero_gap_bitslice_floorplan:
      blocks: ["PLA Decoder", "Register Field", "16-bit ADDER", "Dual-Nibble 8-bit ALU"]
      isolation_ns: "7 - 11 ns pass-gate isolation"
      byte_order_lock: "AB:AA (AB = high byte, AA = low byte); SIGN_EXT latch for signed displacement"
      pla_drive_rule: "Loading DL (DECODER_LATCH) directly drives PLA decode; every canonical sequence self-chains with trailing LD:W DL,(...)"

    two_tier_stall_and_clock_gating:
      short_dram_pacing_1q_to_4q:
        method: "Synchronous 14.18758 MHz OR-gate CPU_CLK high-park BEFORE non-overlapping Phi1/Phi2 generator"
        granularity_ns: 70.484
        max_high_park_ns: 2000  # Z80A / NMOS dynamic-node retention limit
        use_case: "Paces -25 (250 ns -> 1.5T = 422.9 ns) and -30/-37 (300-375 ns -> 2.0T = 563.9 ns) salvage DRAMs without runt pulses or Phi1/Phi2 skew"
      long_stalls_gt_4t:
        method: "Free-running Phi1/Phi2 clock with decoder state-hold on !DATA_READY / WAIT_SAMPLED + weak depletion keepers"
        use_case: "BUSRQ/BUSACK DMA grants, >4T ULA/peripheral stalls, HALT loops"

    virt_en_34pin_rerole:
      trigger: "VIRT_EN = NOR(/IORQ, /RFSH) (both /IORQ=0 and /RFSH=0 impossible in vanilla Z80)"
      fixed_pins_6: ["CLK", "/RESET", "VCC", "GND", "/IORQ", "/RFSH"]
      rerole_pins_34:
        dds_dram_14pin:
          pins: ["AD[7:0]", "A8", "A9", "/WE_L", "/WE_H", "WAIT_SAMPLED", "CROSSBAR_ODD_EVEN"]
          protocol:
            - "Speculative continuous-read assumption: /WE_L=1 & /WE_H=1 executes default 1T DDS Read on every CPU crossbar slot; CPU discards DATAPINS if no RCYCLE/LD active"
            - "Write override: asserting /WE_L=0 and/or /WE_H=0 converts the 1T slot into byte or 16-bit word Early Write"
            - "Linear addressing up to 1 MB via AD[7:0] Row/Col + muxed A8/A9"
            - "CROSSBAR_ODD_EVEN is an input driven directly by VDP master pin to frame 1T Odd/Even slots"
            - "WAIT_SAMPLED is sampled continuously during LD:* capture phase (1T..3T variable DRAM/contention support)"
        sram_16bit_muxed_18pin:
          pins: ["SD[15:0]", "/SWE_L", "/SWE_H"]
          protocol:
            - "0.5T cycle: Phi1 drives 16-bit address SA[15:0] (latched externally by 74ALS373/74F573 on Phi1->Phi2), Phi2 transfers 16-bit data SD[15:0]"
            - "Same always-read / write-override convention: /SWE_L=1 & /SWE_H=1 = 16-bit Read; /SWE_L=0 and/or /SWE_H=0 = Low/High byte or Word Write"
            - "Supports 512x16 (1 KB) up to 32Kx16 (64 KB) linear SRAM concurrently with DDS DRAM"
        interrupt_pins_2: ["/INT", "/NMI"]
      auto_disarm_to_vanilla_z80:
        conditions: ["EPROM read (0x0000-3FFF when ROM_OVL_EN=1)", "Legacy /IORQ instructions (IN/OUT)", "HALT instruction", "External /BUSRQ assertion"]
        safeguards:
          - "Crossbar 74F245/74F125 drivers immediately tri-state (Hi-Z) when VIRT_EN=0"
          - "4.7 kOhm pull-up resistors on /WE_L, /WE_H, /SWE_L, /SWE_H float all write strobes HIGH (write-locked) across mode transitions"

    external_sram_1024b:
      baseline_chips: "4x 2114-12 (512x16 = 1 KB) or 2x 6116-12 (2Kx16 = 4 KB), scalable to 64 KB"
      address_latch: "1x 74ALS373 / 74F573 clocked by Phi1 edge"

  bus_arbitration:
    topology: "Odd-Even 2T ULA/CPU Crossbar (1T VDP turn + 1T CPU turn = 80 active turns/line each; VDP can burst-steal up to 160 turns/line in RGB332/RGB565 full-saturation modes while CPU runs from 16-bit SRAM)"
    bank_exposure: "Single unified /RAS exposed by crossbar to active side (no /RAS0-/RAS1 split needed)"
    crossbar_bom_5ic:
      cpu_side_3ic:
        - "1x 74F245 (octal bidir transceiver for AD[7:0]; DIR=A->B on Write & Q0..Q1 Read addr, B->A on Q2..Q3 Read data; /OE gated by CPU_TURN & VIRT_EN)"
        - "1x 74F125 (or 74F244) quad tri-state buffer for A8, A9, /WE_L, /WE_H"
        - "1x 74F02 quad NOR for VIRT_EN = NOR(/IORQ,/RFSH) & /XBAR_OE gating"
      vdp_side_2ic:
        - "1x 74F245 (octal bidir transceiver for VDP_AD[7:0])"
        - "1x 74F125 (or 74F244) quad tri-state buffer for VDP_A8, VDP_A9, /VDP_WE_L, /VDP_WE_H"
      propagation_delay_ns: "5 - 7 ns single wired-OR tri-state stage"

  resig_bus_ctrl:
    dram_spd_presets:
      mode_0_fast: "1.0T (281.94 ns) for -15/-20 DRAM"
      mode_1_salvage_25: "1.5T (422.91 ns, +2Q high-park) for -25 (250 ns) DRAM"
      mode_2_slow_30: "2.0T (563.87 ns, +4Q high-park) for -30/-37 DRAM"
      mode_3_contended: "2.0T - 3.0T via WAIT_SAMPLED / DATA_READY state-hold"
    iorq_default_window: "5H (2.5T = 704.84 ns) active /IORQ strobe matching VZ80REMIX 15/1..18/1 trace; ULA MMIO uses 0 /IORQ ports (+0x7F0..7FB at 0.5T-1T)"

  enclosure_bom:
    dram_pcb:
      glue_ics: "2x 74F543 bidirectional registered transceivers (DATA_L, DATA_H) + 33R series damping resistors"
      evicted_ics: ["ADDR_BUF (74F244) evicted — motherboard crossbar 74F245 now buffers AD[7:0] directly across J1"]
      j1_34pin_notes: "Single unified /RAS; LE_L, LE_H, /DDS_OE_L, /DDS_OE_H generated by Q0..Q3 phase decoder; pin 16 and pin 22 freed as spare/rsvd"

  emulator_trace_ref:
    source: "VZ80REMIX transistor-level NMOS Z80 simulator at 3.546895 MHz (half-T logs report settled state at end of each phase)"
    key_findings:
      - "Standard operand read takes 3.0T (6 half-Ts = 845.81 ns): AB valid at T1 rising (0 ns), /MREQ+/RD fall at T1 falling (140.97 ns), ULAT opens transparent DLATCH at T2 rising (281.94 ns), /WAIT sampled at T2 falling (422.91 ns), BUSRQ sampled & DLATCH closes at T3 rising (563.87 ns), reg=DLATCH at T3 falling (704.84 ns)"
      - "HALT trace (2/0..4/1) proves ULAT/ULATO is a level-sensitive transparent pass-gate that resamples DB on every rising edge while UWAIT loops on /WAIT=0; HALT keeps SIGEXEC=0 and repeatedly grants BUSRQ/BUSAK until INT/NMI"
      - "LD (nn),A quirk: UPCDWQ merges W = LBUS OR HBUS (A | F) at 5/1, and ULWA overwrites W = DLATCH (A) at 13/1, leaving WZ = (A<<8) | ((nn+1)&0xFF)"
      - "LD A,(nn) leaves WZ = nn + 1 without W overwrite"
      - "IN A,(n) runs 4.0T (1,127.8 ns) with 5H (/IORQ+/RD active 15/1..18/1) and leaves WZ = ((A<<8)|n) + 1"

  opcode_risc_break:
    primitives:
      - "LD:W <dst>,(<src>:AO><inc>) : Drive <src>->AO, update <inc> (AL+ or PC+), initiate 1T read (2 half-Ts on DRAM, 0.5T on 0WS SRAM), sample WAIT; loading DL triggers PLA decode"
      - "LD:WAIT <dst>,(<src>:AO><inc>) : Same read cycle with explicit WAIT pin sampling across capture half-T"
      - "LD:DF:W <cond> DL,(<src>:AO><inc>) : Conditional early-cancel opcode fetch (Decode-Flush) when <cond> is true"
      - "LD:W !OCC DL,(AO>PC) : Conditional early-cancel opcode fetch when branch/call condition OCC is false"
      - "INCLD2 PC>AO+2 : ADDER adds +2 to PC into AO (skips 16-bit immediate nn)"
      - "DECLD AA,<r> : Dual-nibble 8-bit decrement <r>-1 -> AA in 0.5T, updates Z flag"
      - "DECLD1 SP-1>AO:AL : Internal 16-bit ADDER decrement SP-1 -> AO and AL in 0.5T"
      - "DECLD1:W (AO-1>AL:SP),<r> : Write <r> to (AO) while ADDER decrements AO-1 -> AL and SP"
      - "NOPLD:W (<addr>),<r> : Pure memory write to (<addr>) with no ADDER increment/decrement"
      - "SADD LL,PCL>AA / SADD CY,PCH>AB : 2-step signed 8-bit relative offset addition using SIGN_EXT & CY"
      - "LD:W WZH:LL,(AL:AO>PC+) : Loads high byte from memory into WZH while shifting LL -> WZL (WZ = nn)"

    canonical_sequences:
      djnz_rel:
        opcode: "0x10"
        timing_t: "3.0T (6 half-Ts) not-taken / 4.0T (8 half-Ts) taken at 3.546895 MHz"
        half_t_columns:
          - { col: 1, bus: "LD:W DL,(PC:AO:AL+)", alu: "-", note: "Primed: fetch 0x10" }
          - { col: 2, bus: "(wait half-t if any)", alu: "decode DJNZ", note: "DL latched -> PLA decode" }
          - { col: 3, bus: "LD:WAIT LL,(AL:AO:PC+)", alu: "DECLD AA,B", note: "Fetch +d into LL; B-1 -> AA (sets Z)" }
          - { col: 4, bus: "(wait half-t if any)", alu: "LD B,AA", note: "LL latched; commit B" }
          - { col: 5, bus: "LD:DF:W Z DL,(PC:AO:AL+)", alu: "SADD LL,PCL>AA", note: "If Z=1: early cancel & fetch next (3.0T); if Z=0: PCL+d -> AA" }
          - { col: 6, bus: "-", alu: "SADD CY,PCH>AB", note: "PCH + SIGN_EXT + CY -> AB" }
          - { col: 7, bus: "LD:W DL,(AB|AA:AO:PC+)", alu: "-", note: "Jump to AB:AA, PC=target+1, fetch next (4.0T)" }

      call_cc_nn:
        opcodes: ["0xC4", "0xCC", "0xD4", "0xDC", "0xE4", "0xEC", "0xF4", "0xFC"]
        timing_t: "2.0T (4 half-Ts) early-cancel (!OCC) / 7.5T (15 half-Ts) taken"
        half_t_columns:
          - { col: 1, bus: "LD:W DL,(AL:AO>PC+)", note: "Primed with prior opcode" }
          - { col: 2, bus: "(wait half-t if any)", note: "DL latched -> decode CALL cc,nn" }
          - { col: 3, bus: "INCLD2 PC>AO+2", note: "Actual CALL cc start: AO = PC+2 (CALL+3)" }
