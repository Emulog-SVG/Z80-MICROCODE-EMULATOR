ula_index_sram:
chip: "1x 2114-12 (1024x4, 120 ns) quad-series nibble SRAM (6 ULA pins: ULA_SD[3:0], ULA_LE_SA, /ULA_SRAM_WE)"
timing: "0.5T (140.97 ns) per nibble = 2T per 16-bit CHAR_CODE; pre-reads 40x 16-bit indices (160 nibbles = 40T) inside a single 42.5T H-blank at Y_FIELD=7, eliminating repeated index fetches across scanlines 0..7"
display_geometry:
active_safe_area: "320 x 240p (or 320 x 480i interlaced)"
borders_pal: "24 px left/right (3.42 us each) + 24 lines top/bottom inside 368 x 288 visible PAL raster (total CRT overscan protection; consumer TVs lack user horizontal squeeze)"
pixel_aspect_ratio: "1.042 : 1 at 7.09379 MHz (within 4.2% of mathematical 1:1 square pixels)"
tv_chroma_trap_rule: "320 px (7.09379 MHz -> 3.55 MHz max stripe) sits safely below the 4.43361875 MHz PAL chroma trap; 640 px modes (14.18758 MHz) use RGB SCART or BURST_DIS chroma-trap bypass"
dds_bandwidth_per_line: "80 active VDP turns x 2B = 160 bytes/line (38,400 B/frame contention-free), or up to 160 turns = 320 bytes/line in full-saturation RGB332/RGB565 modes"
memory_layout:
font_base_default: "0x4000 (16384) — pure A14=1 wire-concatenation (zero adder gates); 0x0000-0x3FFF left free for CPU RAM/system vars"
coupled_text_words: "Immediately follows FONT_BASE (0x4800 / 0x5000 / 0x6000); 16-bit word packs DATA_L = CHAR_CODE[7:0] and DATA_H = ATTR[7:0] in a single 1T DDS fetch"
alt_zero_base_skew: "TEXT_BASE = 0x0000 (VSYNC counter clear) with +128 (0x1000) / +256 (0x2000) upper-byte CHAR_CODE skew up to 1 MB linear DRAM ceiling"
interlace_indexing: "FIELD_ODD toggle drives glyph row parity (Even field = rows 0,2,4..14; Odd field = rows 1,3,5..15)"
modes:
mode_0_8x8i_text: "80x60 (640x480i) or 40x60 (320x480i), 8-bit CHAR (0..255) + 8-bit ATTR coupled word, 2 KB font at 0x4000"
mode_1a_8x16i_text: "80x30 (640x480i) or 40x30 (320x480i), 8-bit CHAR (0..255) + 8-bit ATTR coupled word, 4 KB font at 0x4000 (4,800B screen buffer)"
mode_1b_16x16i_text: "20x30 (320x480i), 16-bit CHAR (up to 32,512 glyphs in 1 MB) + 16-bit ATTR + 16-bit GLYPH in 3 DDS turns + 1 free turn/cell"
mode_2_raw_640x480i_bitmap: "On-the-fly 0..4799 cell counter (80x60 8x8i cells): 4,800B linear ATTR at 0x0000 + 38,400B linear 640x480i bitmap at 0x12C0 (ZX 6912-style attribute clash, zero CPU tile shifts, endless modulo-4800 wrap-around)"
mode_3_8x2bpp_lrgb4: "320x480i (8 x 2 BPP = 16 bits/word) with ATTR[15:0] = 4 x 4-bit LRGB ([C3, C2, C1, C0] selected by 2-bit pixel P[1:0]) for 4-color cells or 4-step luma anti-aliased text"
mode_4_direct_4bit_lrgb: "Direct 4-bit LRGB (16 colors/px, zero attributes): 320x480i (75 KB, 80 turns/line contention-free) or 640x480i (150 KB, 160 turns/line full saturation)"
mode_5_direct_rgb332: "Direct RGB332 (256 colors/px, 2 pixels per 16-bit DDS word): 320x480i linear bitmap (150 KB, 160 turns/line) or 40x30 8x16i / 20x30 16x16i 256-color tiles"
mode_6_direct_rgb565: "Direct RGB565 (65,536 colors/px, 1 pixel per DDS word): 140x480i / 160x480i via 1 CHAR_16 + 7/8 RGB565 reads per cell"
