risc_main_page: # 256-slot active half of 512-op page (rows=low 0..F, cols=high 0..F; op=(col<<4)|row; gaps=---)
col_0: "[NOP, LD LL,n, LD (AO):AL+,A, LD (AO):AL+,OR, LD PC,n:LL, LD A,(AO):AL+, LD A,(BC):AO:AL+, RLCALD A, EX AF,AF', IO RD,(BC):WZ+, ---, ---, ---, ---, ---, RRCALD A]"
col_1: "[LD (BC):AO:AL+,A, LD (BC):AO:AL+,OR, LD (AO):AL+,OR_H, LD (ORR):AO,LL, LD ORR,n:LL, LD OR,(AO):AL+, LD A,(DE):AO:AL+, RLLD A, NOPLD ORR:AO:AL:ORR, IO WR,(BC):WZ+, ---, ---, ---, ---, ---, RRLD A]"
col_2: "[LD (DE):AO:AL+,A, LD (DE):AO:AL+,OR, LD (AO):AL+,OR_L, LD OR,LL, LD WZ,n:LL, LD OR_L,(AO):AL+, LD (AO):AL+,n, DAALD A, DECLD1 BC.PV, IO RD,(A:n):WZ+, ---, ---, ---, ---, ---, CPLLD A]"
col_3: "[INCLD1 ORR:AO:AL:ORR, DECLD1 ORR:AO:AL:ORR, INCLD2 APC:AO:AL:APC, DECLD2 APC:AO:AL:APC, INCLD1 WZ:AO:AL:WZ, DECLD1 WZ:AO:AL:WZ, LD AA,A, SCF, ---, IO WR,(A:n):WZ+, ---, ---, ---, ---, ---, CCF]"
col_4: "[LD B,LL, LD B,C, LD B,D, LD B,E, LD B,H, LD B,L, LD B,LR, LD B,A, LD C,B, LD C,LL, LD C,D, LD C,E, LD C,H, LD C,L, LD C,LR, LD C,A]"
col_5: "[LD D,B, LD D,C, LD D,LL, LD D,E, LD D,H, LD D,L, LD D,LR, LD D,A, LD E,B, LD E,C, LD E,D, LD E,LL, LD E,H, LD E,L, LD E,LR, LD E,A]"
col_6: "[LD H,B, LD H,C, LD H,D, LD H,E, LD H,LL, LD H,L, LD H,LR, LD H,A, LD L,B, LD L,C, LD L,D, LD L,E, LD L,H, LD L,LL, LD L,LR, LD L,A]"
col_7: "[LDAO LL,(BC), LDAO LL,(DE), LDAO LL,(HL), LDAO LL,(AW), LDAO LL,(IX), LDAO LL,(IY), ---, ---, LD A,B, LD A,C, LD A,D, LD A,E, LD A,H, LD A,L, LD A,LR, LD A,LL]"
col_8: "[ADDLD A,OR, ADDLD A,(HL), ADDLD A,n, RLCLD AA, SLALD AA, BITLD OB,AA, RLDLD AA, LD AL,SP, ADCLD A,OR, ADCLD A,(HL), ADCLD A,n, ---, ---, ---, ---, ---]"
col_9: "[SUBLD A,OR, SUBLD A,(HL), SUBLD A,n, RRCLD AA, SRALD AA, RESLD OB,AA, RRDLD AA, LD AA,(AO):AL+, SBCLD A,OR, SBCLD A,(HL), SBCLD A,n, ---, ---, ---, ---, ---]"
col_A: "[ANDLD A,OR, ANDLD A,(HL), ANDLD A,n, RLLD AA, SLLLD AA, SETLD OB,AA, NIBREV AA, LD AB,(AO):AL+, XORLD A,OR, XORLD A,(HL), XORLD A,n, ---, ---, ---, ---, ---]"
col_B: "[ORLD A,OR, ORLD A,(HL), ORLD A,n, RRLD AA, SRLLD AA, NEGLD A, NIBREV AR, ---, CPLD A,OR, CPLD A,(HL), CPLD A,n, ---, ---, ---, ---, ---]"
col_C: "[FETCH2 OCC, FETCH1 OCC, FETCH0 OCC, LD Z,(SP):AO:AL+, LD W,(AL):AO:SP+, SADDLD AB,IXL, SADDLD AB,IYL, SYS IFF1=0, LD AA,0, ---, ---, ---, ---, ---, ---, ---]"
col_D: "[LD (SP):AO:AL+,OR_H, LD (AL):AO:SP+,OR_L, LD OR_L,(SP):AO:AL+, LD OR_H,(AL):AO:SP+, LD AA,n, SADDLDCARRY AA,IXH, SADDLDCARRY AA,IYH, SYS IFF1=1, LD AB,RST_VEC, ---, ---, ---, ---, ---, ---, ---]"
col_E: "[LD (SP):AO:AL+,PCH, LD (SP):AO:AL+,PCL, LD (AL):AO:AL+,H, LD (AL):AO:AL+,L, SADDLD AB,PCL, SADDLDCARRY AA,PCH, LD:DF APC:AO,AA:AB, SYS IFF1=IFF2, LD AB,0x66, ---, ---, EX DE,HL, ---, ---, ---, ---]"
col_F: "[LD WZ:AO,AA:AB, NOPLD WZ:AO:AL:APC, NOPLD WZ:AO:AL:HL, DI, LD WZ:AO,LH:LL, NOPLD HL:AO:AL:SP, LD APC:AO,WZ, SYS IM=0/1/2, LD WZ:AO,0x0066, ---, ---, EI, ---, ---, ---, ---]"
emulator_trace_ref: # separated raw NMOS VZ80REMIX microcode log reference (never leak emulator uops into opcode_risc_break)
source: "Locality/NMOS (VZ80REMIX half-T trace)"
key_findings:
- "ADDER=input/addr-out latch (ADDR=ADDER on x/0), ADDES=ripple output latch (NOPLD/INCLD/DECLD/INCLD7 on x/0, reg commit on x/1), direct feedback ADDER=ADDES (UPCDD/USPDD/UWZDD)"
- "JP (HL)/IX/IY ends with UDHL (ADDER=HL) + DONEI without writing PC; all WZ jumps end with UDWZ (ADDER=WZ) + DONEI; normal ops end with UDPC (ADDER=PC) / DONEIPC"
- "LD (nn),A sets WZ=(A<<8)|((nn+1)&0xFF) via UWZDWW (WZ=ADDES) + UWDL (W=DLATCH from HBUS=A)"
- "CALL cc,nn late-tests cc at 12/1 (UPCDJNC) after reading lo & starting hi read, wasting 13/0..14/1 on false cc; RET cc early-tests cc at 4/0 (UBRMJNC) & aborts stack reads on false"
- "ADD/ADC/SBC HL,RR runs 2x 8b ALU passes (lo then hi) & writes WZ=HL+1 at 26/1 (UOADDWZD); ADC/SBC chains sticky zero via XFZ"
- "RLD/RRD uses NIBB-REV-BUS swapping nibbles between ALUA ((HL)), ALUB (A), & HBUS; block ops (LDI/CPI/INI/OUTI) step pointers via ADDER while computing quirk flags (UOADDNQ/UOCPNQ/UOADDQ/UOXORQ) & loop via 2x DECLD1 on WZ->PC"
- "IM0/1/2 & NMI suppress PC increment at M1 ack via NOPLD (UDLM/UADLMR), push PC via DECLD1 SP, & vector via IR (IM0/1), (I:vec) table read (IM2), or 0x0066 (NMI)"
isa1_microarch:
pipeline: "3-stage R800-style pipeline + 16b prefetch buffer; 4-bit sliced ALU (16b in 2T, 32b AW:BC/HL:DE in 4T, nibble-sliced 16x16->32 MUL ~16T & 32/16->16 DIV ~16-20T); distributed Phi1/PHI2 6T latches at D[7:0] pad ring"
bus_dual_pc: "dram_pc (64KB ext 8b bus via 0.5T-phased 8+8 byte-sequencer on AD[7:0], 1T Fast Page / 2T row miss); sram_pc (0WS 16b Local SRAM/opcache); V = 0WS SRAM window ptr; XJP n sets SRAM_PC<-(n<<2) & switches fetch to SRAM_PC preserving DRAM_PC; XJP (V) jumps via (V); XRET switches fetch back to DRAM_PC"
resig_bus_ctrl:
spec: "v2.0 Autonomous 8-Mode Memory, Bus & RESIG Interface (~716T NMOS 4T, 4MHz 1H=125ns, REQ/DATA_READY, BYTE_EN[1:0], A_IN[23:0], bidir /BUSACK)"
cfg_regs: "CFG_SEL 00=CFG_MODE_CTRL([2:0]MODE,[4:3]SRAM_SPD,PAGE_EN) | 01=CFG_DMA_PACE[7:0] | 10=CFG_ROM_SEG(ROM_OVL_EN=1,[6:4]ROM_SIZE,[3:0]ROM_BASE; ROM_HIT overrides EFF_MODE->001)"
eff_modes: "0:IO(5H) | 1:Z80/ROM(RESIG /ROM_CS & /SHADOW_WR, bypasses /BUSACK) | 2:8b_Mux_DRAM(1T hit/2T miss/3H rfsh) | 3:24A/16D_Mux | 4:16A/16D_Lin | 5:16b_Mux_DRAM(split /CAS_L/H) | 6:4b_SRAM_2114(2H nib) | 7:Fast_8b_SRAM(1H, ignores /BUSACK)"
resig_strobes: "VIRT_EN=NOR(/IORQ,/RFSH) masks clean Z80 strobes; STATE[3:0]={/M1,/MREQ,/RD,/WR} decodes 0:/ROM_CS 1:/SHADOW_WR 2:/SRAM_RD 3:/SRAM_WR 4:/RAS_OPEN 5:/RAS_CLOSE 6:/CAS_L_RD 7:/CAS_L_WR 8:/CAS_H_RD 9:/CAS_H_WR A:/CAS_16_RD B:/CAS_16_WR C:/MUX_ALE D:/MUX_RD E:/MUX_WR F:rsvd"
opcache_capture: "OP_START, OP_LEN, OP_CUR latches; CATCH streams fetched opcodes to SRAM[OP_CUR++]; END captures trailing branch inst then halts capture; CATCH/END act as 1T NOP when fetching from SRAM_PC; all branches inside SRAM_PC stay in SRAM_PC until XRET"
external_word_sram: "4x 2114L-2 (200ns, 1T) or 2114H-1 (120ns, 0.5T) 512x16 (1KB base, scalable to 64KB) on SD[15:0] (40p Pin-21 keyed)"
loop_accel: "IR performs INC HL+INC DE; DR performs DEC HL+DEC DE; IRLR/DRLR repeat until LAST_REG==0 using active LAST_REG width (8b/16b) and INC/DEC step; IRNZ/DRNZ repeat while Z==0 (NZ) and fuse with Tier-1 ACT_CC to override condition with active CC8 slot"
e_carry: "16b carry/bitfield shift-buffer CY[15:0] (CY==F.C); updating CY via bitfield ops (e.g. BEX n) binds CY as active LAST_REG for subsequent LR addressing/ops"
dialect: "sjasmplus (standard Zilog mnemonics + ISA-1 prefixes; 0x hex, 0b binary)"
z80_baseline: "Vanilla Z80 baseline assumed NMOS with all undocumented opcodes and flags treated as documented"
virtual_slot_rule: "All new opcodes/prefixes are added virtually first (virtual_first_allocation) and assigned physical page slots later"
virtual_ops:
- "CALL_INT_M2 n: IM2 vectored SW INT via I:n, saves/clears IFF1"
- "CALL NMI: SW NMI to 0x0066, IFF2<-IFF1, IFF1<-0"
- "XLAT LR,A: reads byte/word from (RR_last + uint16(A)) -> A, flags unaffected"
- "BSWAP LR / EZX LR / ESX LR: byteswap hi<->lo / zero-extend lo->hi / sign-extend lo->hi of RR_last"
- "LTOH LR / HTOL LR: broadcast RR_lo->RR_hi / RR_hi->RR_lo on active LR target"
- "LLZX LR / LLSX LR: zero-extend / sign-extend RR_lo into RR_hi on active LR target"
- "LD A,LR / LD LR,A / INC LR / DEC LR / LD LR,n / LD LR,nn / JP (LR): core LR data-move, inc/dec, imm, & indirect jump primitives"
- "STACK_DEPTH n / STACK_FLUSH / STACK_FETCH: set Stack FIFO depth in SRAM (0=disable), flush full FIFO_depth to DRAM, fetch full FIFO_depth from EXX0.SP"
- "BEX n: extracts bitfield [n[7:4]+n[3:0]-1 : n[7:4]] from LR into E-CARRY CY[15:0] (binds CY as LR)"
- "PEX LR,n: deposits low n[3:0] bits of E-CARRY CY[15:0] into RR_last starting at bit n[7:4]"
- "MIRR LR: autosized 8b/16b bitwise mirror of LAST_REG via zero-gate wire reversal, flags unaffected"
- "FIND0 LR,A / FIND1 LR,A: lowest 0-bit / 1-bit index of LAST_REG -> A, Z=1 if none"
- "SET_OP_CUR n: loads OP_CUR SRAM opcache capture pointer"
- "CATCH / END: start/stop SRAM opcache capture (captures 1 trailing branch after END; NOP in SRAM_PC)"
tsv_view: "Canonical TSV page view is transposed: rows=low 0..F, cols=high 0..F, op=(col<<4)|row"
regs_banks:
banks: "4 banks EXX0..3 selected by 2b latch (0xCA/DA/EA/FA); per-bank {AW,BC,DE,HL,IX,IY,SP,V,F} evicted to 0WS 16b SRAM"
link_reg: "LR (16b internal link/scratch reg: LR0=lo, LR1=hi, updated on A writes)"
last_reg_2: "LAST_REGISTER_2 (LR2): init undef; arises ONLY via MEM*+MEM* mixture or EXTEND (V) pfx (never auto-shifted on LR writes; 0 standalone LR2 ops); inherits pre-last LR on pfx fusion; mutates all LEFT ops while last-win pfx mutates HL, H, L, & SP"
sp_binding: "All stack ops (CALL,RET,LDI/LDD (SP),PUSH/POP n,EX (SP),RR,INC/DEC SP) bind permanently to EXX0.SP (1T in SRAM); EXX0..3 switch NEVER switches SP or flushes Stack FIFO (flushes only on direct EXX0.SP write outside INC/DEC SP or (EXX0.SP+d) index)"
m1_pipeline:
model: "Stateless M1 pfx latch loop + 8x16b MEM[0..7] macro latches; terminal esc pgs: 0x27=LRPAGE, 0x2F=BITPAGE, 0x3F=BITPAGE$; terminal op inherits T1 ACT_CC guard, T2 REP0..7 9b rep count, & T3 MEM[0..7] RR mutation/affection"
tiers: "T1: ACT_CC (0x88..8F, main-only fixed CC8 fast-skip guard, fuses w/ IRNZ/DRNZ) -> T2: REP0..REP7 (0x98..9F, 9b SHL3 repeat latch 0..511; w/ RET pops addr once then SP+=2rep_count) -> T3: fusable MEM[0..7] & modifier stream"
cc8_fixed: "Fixed non-programmable ACT_CC[0..7] = CC8 [NZ,Z,NC,C,PO,PE,P,M]; fast-skip advances PC past guarded op immediate bytes without memory reads when condition is false"
rr_shift: "MEM[0..7] always replays stored 16b latch (cold-boot & RESET/MEMDEF default = RR8[0..7] + SSDEF); standalone MEMx or MEM-only chains never overwrite latch; terminal MEMx preceded by >=1 non-MEM* pfx fuses & memorizes 16b state [8b affection (REV[1b], STICK[1b], RR_affection[4b], WORD[1b], 1b rsvd) + 4b LR2 + 4b DEST_RR]; in MEM*+MEM* preceded by modifiers, pre-last MEM* fuses flags & last MEM* memorizes; any two MEM* enable LR2 affection; last-win pfx mutates HL/H/L/SP"
shadow_gather: "MEM[0..7] default RR mutation mapped 1:1 to RR8[0..7] (AW,BC,DE,HL,IX,IY,SP,V); each RR pfx updates LEFT/RIGHT bank latches via SS (boot SSDEF: AW:L1, BC:R1, DE:X1, HL:XC, IX:L2, IY:R2, SP:X2, V:XC)"
width_rev: "Vanilla Z80 operand widths by default; WORD promotes all ops to 16b; WORDB evicted; WBZ: LEFT=16b word, RIGHT=zext16(byte); WBS: LEFT=16b word, RIGHT=sext16(byte); WB$/WB$$: LEFT=16b word, RIGHT=rel8/rel16 (on non-rel ops e.g. LD/ALU, RIGHT is unsigned byte ZX, e.g. LD C,E->LD BC,E; implicit 1-op INC/DEC expand as ALUOP dst,1->dst before mutation; RIGHT (HL)->(HL+$) [AM evicted to ?]; LEFT (HL)->(HL+d); native 16b RIGHT RR truncates ZX to low byte; ,nn & OUT/IN (n) immutable; DJNZ/JR immutable on WB$, promote to dd on WB$$); REV (0x37) or R/WR swaps LEFT<->RIGHT after all mutations (1-op intact, auto-clears at retirement)"
word_mutation_rules:
root_word: "WORD (0x33): applied over vanilla Z80 main page; promotes LEFT, RIGHT, & DEST to 16b; A/AF->AW; LEFT RRH->RR' (shadow), RIGHT RRH->RR, all RRL->RR; (HL) stays (HL) (no (V)); +d/nn in branches->dd (rel16); PUSH/POP->RR'; 0x76 HALT->LD (HL),(DE); 0xC9 RET->RETI; 0xF3 DI->RLD; 0xFB EI->RRD; omit '1,' in INC/DEC mnemonics; 0-param ops stay vanilla; dupes ok, ambiguous->---"
wordrev: "WORDREV (0x37): inherits root_word updates + swaps LEFT<->RIGHT; RIGHT AW->AW'; LEFT nn->(nn); 0xC9 RET->RETN; impossible/ambiguous->--- (6 slots: 0xCB,0xD3,0xDB,0xDD,0xED,0xFD)"
wordlr: "WORDLR (0x3B): inherits root_word; LEFT RRL->LR, RIGHT RRH->LR (if LR,LR -> right LR'); LEFT AW->AW'; even ALUOP AW,LR -> AW',LR'; SP->LR across ops (incl CALL/RET/PUSH/POP/EX via (LR))"
wordlrrev: "WORDLRREV (0x3F): inherits wordlr + post-apply REV swap (no extra WORDREV rules); ambiguous->---"
sticky_rr: "Triggered exclusively by virtual STICK pfx (identical consecutive MEMx+MEMx removed as sticky trigger); locks rr_curr, shadow triggers, & width across subsequent insts until new MEMy or MODE_"
virtual_pfxs: "STICK (arms sticky mode); MEMDEF (restores MEM[0..7] latches to register-order defaults); WB$$ (LEFT=16b word, RIGHT=rel16); DEST_LR (dst override to LR); EXTEND nn (imm16 direct load of 16b MEM state, supersedes 8b AFFECT n); EXTEND (V) (loads 16b MEM* state from 0WS SRAM (V) ptr, can activate LR2); SATU / SATS (unsigned / signed ALU saturation, auto-clears at retirement)"
am_rr_modes: "?[fut] evicted for future task (3b per-reg latch via AM n/LR on LRPAGE: 0:NONE | 1:+D | 2:+DD | 3:INC | 4:DEC | 5:+HL1 | 6:+HL2 | 7:+HL3)"
ss_rr_modes: "6b per-reg latch (n[2:0]=LEFT, n[5:3]=RIGHT) via SS n on LRPAGE; codes {0:EXX0, 1:EXX1, 2:EXX2, 3:EXX3, 4:CURR}; 0x27 0xD9=SSDEF"
