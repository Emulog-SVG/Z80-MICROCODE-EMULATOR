meta_spec:
  id: LLM-STATE-HANDOVER-v6.0-UNIFIED
  obj: Lossless Z80 ISA-1 & ZX Spectrum 48K handover; bottom-up cascade decode, 0 stored grid variants, 0 invented ops.
  strict:
    no_guess: Never guess ambiguous/incomplete input. If deterministic mapping fails, HALT and ask only missing/ambiguous items (max 3).
    replies: On edits, emit ONLY 1-line ACK (e.g., OK: +pg0 0001xxxx=ADD | FREE -1). On page views ("show main page"->pg1, "show pg0", "show hl_pg"), emit ONLY transposed 16x16 ```tsv (rows=low 0..F, cols=high 0..F; op=(col<<4)|row; no hex headers; gaps=---). 0 prose. Append " | [HANDOVER_REC]" after ~15 edits or ~5 TSV dumps.
    fut_capture: Scan session context on every export; auto-flush all unbound assumptions, tentative microarch ideas, & unallocated concepts into isa_state.future_tasks as terse key-summary entries (deduped, 0 prose); promote to hw_invariants/pg0 only on explicit commit.
    export: Keep meta_spec & isa_state internal on normal turns. On export/handover request, run fut_capture, coalesce adjacent FREE masks, prune dead overrides, emit ONLY single unbroken ```yaml block with verbatim meta_spec + compacted isa_state + EOF sentinel; 0 prose before/inside/after.
    ingest: On `CHUNK i/N` or `PART i` (i<N), buffer silently -> reply `ACK i/N`. On `END`, `i==N`, or raw URL load -> merge, audit, reply `READY`. Auto-iterate all entries in `reference_corpora` on session start before ROI/opcode analysis. On empty/404/inaccessible URL, treat accompanying inline text or auto-boxed attachment block (`File: [source: N]...`) as URL payload (no HALT/error).
    compress: Apply terse domain abbrs (pg, def_pg, esc, sw, pfx, op, sem, var, excl, recon, hw) & macro arrays inside isa_state only; keep meta_spec verbatim, pure ASCII, lines <= 115 chars.
    gen_isa: Store ONLY canonical base pages (pg0 + non-derived esc pgs) as bottom-up cascade bit-masks (MASK=MNEM | flags). Define sibling main pgs (pg1..pg3) & RR-prefixed pgs as deterministic mutation rules over pg0; recon on demand via transform rules & !immune locks.
    slots: Track unallocated/evicted patterns per page as FREE / ---. Fill FREE only via user-migrated ops (freeing source) or user-defined ops; 0 auto-fill/invention.
    audit: On writes/exports, internally verify (1) 256/256 deterministic coverage & 0 mask collisions across canonical & derived pages, (2) 4-point RR PLA truth-table invariants (uniform group branch target addressing, active EXX without suffix on mutated (RR+)/(SP)->(RR+), REV/*R/*WR swaps all 2-op LEFT<->RIGHT while leaving 1-op intact, explicit left A on all RR ALU ops), (3) all custom abbrs resolve, (4) `reference_corpora` verbatim preserved & URL-checked. Abort export & ask up to 4 issues on failure.
  exec: Enforce strict; audit on writes & exports.

isa_state:
  arch: Z80 ISA-1 (Custom NMOS Hybrid R800-Pipelined Core + Vanilla Z80A Slave; Z80-EX v7.9.6 lossless ISA root)
  def_pg: pg1 # MODE_V active at reset; pg0 (MODE_Z) is canonical mutation root
  reference_corpora:
    - "https://githubusercontent.com"
    - "https://githubusercontent.com"
  macros:
    R8: [B,C,D,E,H,L,(HL),A]
    RR3: [BC,DE,HL]
    RR4: [BC,DE,HL,SP]
    RR8: [AW,BC,DE,HL,IX,IY,SP,V]
    SETLR_RR: [AW,BC,DE,HL,IX,IY,SP,F]
    SETLR_IND: [(BC),(DE),(HL),(LR)]
    SETLR_IDX: [(IX+d),(IY+d),(SP+d),(LR+d)]
    RR_AFFECT16: [AW,BC,DE,HL,IX,IY,SP,(V),LR,EF,PC,(NN),rsvd,rsvd,rsvd,rsvd] # V==(V) vector access
    HALF_RR: {AW: A/W, BC: B/C, DE: D/E, HL: H/L, IX: IXH/IXL, IY: IYH/IYL, SP: S/P, V: VH/VL}
    CC4: [NZ,Z,NC,C]
    CC_EVEN: [PO,PE,P,M]
    CC8: [NZ,Z,NC,C,PO,PE,P,M]
    CC32:
      - [NZ, Z, NC, C, PO, PE, P, M, BE, A, L, GE, LE, G, H, NH] # 0..15 single-step F
      - [ZZ, NZZ, BEZ, AZ, LEZ, GZ, VV, CC] # 16..23 cascaded F + OLD_F (Z_pair = Z & Zp)
      - [OVP, OVN, NC2, C2, CEZ, CNZ, ADD, SUB] # 24..31 saturation, bounds & step-delta
    EXX_BANKS: [EXX0,EXX1,EXX2,EXX3] # explicit 0..3 suffix for targeted banks; omit suffix for active latch
    FLAGS: { "!": "!immune", "?": "[fut]", n: imm8, nn: imm16, dd: rel16, e: rel8 }

  hw_invariants:
    least_tr_solution: # canonical & primary section
      base_evolution: "Vanilla Z80 main page is lowest-TR root; evolve by evicting low-ROI ops then migrating prefixes to mutate/bind base page"
      word_vanilla_mutation_test: "WORD prefix family originally applied over vanilla Z80 main page as root to define deterministic mutation rules"
      virtual_first_allocation: "All new ISA ops/pfxs added first as real virtual defs without immediate slot binding; physical page/slot fits defined later"
      lr_latch_mutation: "Single LR latch tracks parent RR pair + addressing mode ((RR),(RR+d),etc.) of last DEST (including H/L/A byte writes & PUSH/POP RR); mutates ops with explicit LR parameter only (no LR2)"
      aw_accumulator_pair: "16b accumulator pair AW (A:W) pairs existing 8b A with companion byte W; avoids dedicated 16b accumulator hardware"
      ef_extended_flags: "16b extended flags pair EF pairs existing 8b F with companion byte E / OLD_F for zero-ALU cascaded condition evaluation"
      old_f_history_latch: "Single-byte OLD_F latch captures prior F on flag updates for 2-step cascaded condition evaluation over (F, OLD_F)"
      nibble_alu_16b_2t: "4b sliced ALU executes 16b ALU ops in 2T (1T+1T two-phase nibble pipeline) instead of full 16b parallel adder/CLA"
      e_carry_16b: "16b carry/bitfield shift-buffer CY[15:0] (CY==F.C); reuses carry chain for bitfield extract/deposit without barrel shifter; binds CY as LR"
      mode_v_window: "MODE_V (pg1 default reset) rewrites non-! {(HL),(nn),nn} operands to 0WS SRAM window ptr (V), cutting explicit addr fields"
      word_prefix: "WORD pfx promotes 8b operands across target ops to 16b word width on 2T nibble ALU without separate 16b opcode pages"
      act_cc_fixed: "Hardwired non-programmable ACT_CC[0..7] skip-guard fixed to default CC8 [NZ,Z,NC,C,PO,PE,P,M]; fast-skip decoder parses guarded op immediate/disp length in M1 & advances PC past trailing bytes without memory reads when false"
      rep0_7_9b_fuse: "REP0..REP7 (renamed from R0..R7) chained pfxs shift 9b repeat latch left by 3 bits (latch=(latch<<3)|REP_idx) for 0..511 repeats across 1..3 pfxs; ACT_CC evaluates per-iteration; REP+RET pops addr once then SP+=2*rep_count"
      external_sram_1024b: "1024B external SRAM via 24-pin muxed A/D with configurable OS speed (0WS/1T/0.5T); supports both 16b physical SRAM (16b mode) & 8b physical SRAM (8b mode); segmented as register store base + universal gap up to stack region"
      stack_fifo: "Hardwired exclusively to EXX0.SP in vanilla & extended modes; resides at SRAM_TOP growing downwards by FIFO_depth; tolerates PUSH, POP, INC SP, DEC SP; any other SP write or (SP+d) access triggers fifo_flush; spills 4B/burst to DRAM on overflow; STACK_DEPTH n sets FIFO_depth (n=0 disables); STACK_FLUSH writes back & invalidates full active FIFO_depth window; STACK_FETCH reloads full active FIFO_depth window from EXX0.SP"
      stack_fifo_memcpy: "Setting FIFO_depth up to 256B via STACK_DEPTH n and running STACK_FETCH at src SP then STACK_FLUSH at dst SP performs zero-CPU-loop bulk block memcpy via external SRAM Stack FIFO"
      push_pop_lr_bind: "PUSH/POP RR sets LR to pushed/popped RR; 0xF1=POP LR, 0xF5=PUSH LR"
    opcode_risc_break:
      principle: "Strict NMOS silicon datapath fidelity: 0 invented latches/ALU ops; decompose CISC multi-byte Z80 opcodes into native 1-step RISC ops + elemental hardware-faithful micro-ops"
      latches:
        adder_3latch: "16b ADDER complex with 3 latches: AO (ADDER input/addr-out driving AB[15:0]), AL (ADDES ripple-carry result latch), & APC (live PC inside ADDER enabling simultaneous :PC / :APC trailing fetch-address capture without separate DONEIPC micro-op)"
        adder_cmds: "NOPLD (+0, universal 16b reg-to-reg move via AO->AL->dst), INCLD1 (+1), DECLD1 (-1), INCLD7 (+1 mod 128 on low 7b for refresh), INCLD2 (+2), DECLD2 (-2); same-half-T fly-capture into AL & AO with ISA-1 fused :AL:RR writeback"
        pad_latch_16b: "16b pad-ring latch LH:LL (LATCH_H : primary LATCH_L); decoder auto-fetches imm n into LL on LD R,n (1-step LD R,LL); LDAO LL,(RR) primes AO=RR, reads (RR)->LL, & ripples AL=RR+1 in 1 step"
        alu_2stage: "Nibble-driven ALU with local PLA (encapsulates 2-phase nibble stepping internally; 0 per-nibble uops) & local AW/AW'/F/F'/FLG/AA/AB/AR + constants (0,1,0xFF,0x66,BITMASK,INV_BITMASK); 2-stage pipeline: <OP>LD computes into AR/FLG -> LD dst,AR; :DF discards F update from FLG"
        lr_reg_field: "Register Field PLA directly resolves LR (LAST_REGISTER) as source/target operand (LD R,LR)"
        fetch_guards: "FETCH1 OCC & FETCH2 OCC extract embedded condition OCC from IR; if !OCC, advance APC+=1/2, skip immediates, & trigger immediate M1 refetch (0 operand bus reads)"
        dram_cycler_bus: "Separate DRAM cycler coupled via bus to decoder, ADDER latches (AO/AL/APC), & Register Field PLA (shared vs dedicated bus topology open in future_tasks)"
      canonical_sequences:
        call_cc_nn: "FETCH2 OCC -> LD (SP):AO:AL+,PCH -> LD (AL):AO:SP+,PCL -> LD LL,n -> LD PC,n:LL"
        jp_cc_nn: "FETCH2 OCC -> LD LL,n -> LD PC,n:LL"
        jp_rr: "NOPLD RR:AO:APC (1 step; next M1 drives ADDR=AO and sets PC=AO+1)"
        push_rr: "LD (SP):AO:AL+,RR_H -> LD (AL):AO:SP+,RR_L"
        pop_rr: "LD RR_L,(SP):AO:AL+ -> LD RR_H,(AL):AO:SP+"
        djnz_rel: "DECLD AR,B -> LD B,AR -> FETCH1 Z:DF -> LD AA,n -> SADDLD AB,PCL -> SADDLDCARRY AA,PCH -> LD:DF APC:AO,AA:AB"
        jr_cc_rel: "FETCH1 OCC -> LD AA,n -> SADDLD AB,PCL -> SADDLDCARRY AA,PCH -> LD:DF APC:AO,AA:AB"
        rlc_idx_r: "LD AA,n -> SADDLD AB,IXL -> SADDLDCARRY AA,IXH -> LD WZ:AO,AA:AB -> LD LL,(WZ) -> RLCLD AR,LL -> LD (WZ),AR [+ LD R,AR if R!=(HL)]"
