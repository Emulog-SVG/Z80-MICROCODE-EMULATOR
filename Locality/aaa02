      - "hardware_environment"
      - "machine_state"
      - "session_context"
      - "next_action"
    sentinel: "HANDOFF_EOF"

  isa_profile:
    base_family: "Zilog Z80"
    active_variant: "Z80 ISA-1 (Custom R800-Pipelined Core) + Vanilla Z80A Slave"
    isa1_microarchitecture:
      pipeline: "3-stage R800-style pipeline with 16-bit prefetch buffer"
      on_die_sram: "512 x 16-bit (1 KB) zero-wait-state (V) scratchpad SRAM (auto-aligned word index 2*v)"
      stack_fifo: "SELECT_SPx hardware Stack FIFO (1T PUSH/POP/CALL/RET; STK_POPULATE and STK_FLUSH)"
      register_banks: "4-bank general register file (EXX0-EXX3)"
      loop_accelerator: "Hardware-latched REP block loops (0 external opcode fetches)"
      bus_interface: "MODE_MUX CPU-side DRAM address multiplexing; 1T Fast Page hits and 2T row misses"
    extensions_enabled:
      - "undocumented_8bit_idx: [IXH, IXL, IYH, IYL]"
      - "undocumented_ops: [SLL]"
      - "isa1_prefixes_and_ops: [WORD, IR, (V), SELECT_SPx, EXX0-EXX3, REP]"
    dialect:
      assembler: "sjasmplus"
      syntax_rules:
        - "Standard Zilog mnemonics plus ISA-1 prefix extensions"
        - "Hex prefix: 0x | Binary prefix: 0b"
      timing_model: "1T (250 ns @ 4.0 MHz) Fast Page / on-die SRAM; 2T random DRAM & odd-even ULA crossbar slots"

  hardware_environment:
    target_system: "Custom 1982-1985 ZX-Class Unified Computer (ISA-1 / Dual-Z80)"
    clocks:
      system_cpu_mhz: 4.000
      ula_pixel_dot_mhz: 7.000
      pal_chroma_subcarrier_mhz: 4.433619
      scanline_budget: "256T per PAL scanline (64.00 us); 146.3T active display + 109.7T border/H-blank"
    bus_crossbar:
      topology: "8-bit AD[7:0] unified bus (8+8 16-bit path evicted for 16-chip cost parity)"
      arbitration: "Low-loss Odd-Even 2T-slotted ULA/CPU crossbar (replaces ULA CLK-stretching)"
      ula_fetch_mode: "Plain 2T reads into external 2x74LS373 ping-pong staging latches (offloads Ferranti 5C102E)"
      effective_mhz:
        isa1_master: "~3.85 - 3.93 MHz (96%-98% efficiency)"
        vanilla_z80_master: "~3.40 - 3.45 MHz (~3.24 MHz @ 3.5 MHz clock)"
        vanilla_z80_slave: "~1.20 - 1.45 MHz concurrent (~2.70+ MHz when Master runs in on-die SRAM/HALT)"
    compute_nodes:
      master_cpu:
        role: "Primary execution, interrupts (/INT, /NMI), unconditional bus priority"
      slave_cpu:
        device: "Z80A (socketed or 1985-populated)"
        arbitration: "SLAVE_WAIT = MASTER_BUS_ACTIVE OR ULA_BUSY; isolated via 74LS244 + 74LS245 during /WAIT"
        boot_identity: "Shares 0x0000 Mask ROM; reads IN A,(0xFE) Bit 5 == 1 to branch to SLAVE_MONITOR"
        basic_integration: "OFFLOAD keyword passes CH-ADD token pointer via 0x5BFA-0x5BFF mailbox using private IX"
    memory_map:
      - range: "0x0000-0x3FFF"
        size: "16 KB"
        type: "Mask ROM (23128 on edge carrier)"
        notes: "Core BASIC, Z80_SLAVE Monitor, OFFLOAD parser, built-in EPROM burner; 0T contention"
