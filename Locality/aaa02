        type: "DRAM (Free User RAM)"
        notes: "Contiguous single-block user workspace (41.5 KB effective capacity with ROM_EXTRA)"
      - range: "0xFF00-0xFFFF"
        size: "~256 B+"
        type: "DRAM (RAMTOP System Area)"
        notes: "VARS, printer buffer, and stack placed at RAMTOP"
    rom_and_programmer:
      carrier_architecture: "Edge-connected ROM carrier PCB (replaces motherboard soldered ROM)"
      population: "1 x 16 KB Mask ROM (replaces 2 sockets; modder-replaceable) + 2 x 28-pin 8 KB (2764-only) sockets"
      onboard_programmer: "Software-timed bit-banged burner (~$0.85 BOM): NE555 + charge pump (12.5V/21V VPP), 2N3906/2N2222, 100R/1kR"
    dram_and_pcb_manufacturing:
      base_dram_1982: "32 KB (8 x 4532 single-rail +5V; eliminates -5V/+12V inverter)"
      upgrade_path_1985: "16 x 16-pin DIP sites with MA8 on Pin 1 + 9-bit ULA refresh -> drop-in 4164 (64K/128K) or 41256 (256K/512K) + 0x7FFD"
      pcb_topology: "Cut-ready corridor between CPU/ULA and ROM/DRAM; sheared and clamped via screw compression interposer (GND/+5V screws)"
    io_ports:
      - port: "0xFE"
        notes: "Vanilla ULA border/keyboard/EAR/MIC + Read Bit 5 = Z80_SLAVE hardware ID flag"
      - port: "0x7F"
        notes: "ROM_EXTRA / DRAM bank toggle & VPP programming arm control"
      - port: "0x7FFD"
        notes: "Future-proof 16 KB bank-paging, shadow-screen flip, and Z80_SLAVE private page select"

  machine_state:
    tracking_mode: "ABSTRACT"
    master:
      registers:
        main: { AF: "0x0000", BC: "0x0000", DE: "0x0000", HL: "0x0000" }
        alt:  { AF_: "0x0000", BC_: "0x0000", DE_: "0x0000", HL_: "0x0000" }
