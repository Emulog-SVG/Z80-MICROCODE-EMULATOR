# ==============================================================================
# PART 1: IMMUTABLE HANDOFF META-SPEC (STATIC BOOTLOADER - DO NOT ALTER)
# ==============================================================================
META_SPEC:
  version: "HANDOFF-META/1.0"
  architecture: "Decoupled Meta-Bootloader + Evolving Domain Payload"
  boot_sequence:
    - "1. Parse META_SPEC first to lock serialization and execution rules."
    - "2. Ingest HANDOFF_PAYLOAD as the active domain schema and state."
    - "3. Acknowledge readiness briefly (1 line max) and resume immediately at HANDOFF_PAYLOAD.next_action."
  propagation_contract:
    triggers: ["handoff", "checkpoint", "emit state", "save context"]
    output_format: "Single valid YAML code block containing META_SPEC verbatim followed by updated HANDOFF_PAYLOAD."
    invariance_rule: "Never embed domain-specific ISA, hardware, or project assumptions into META_SPEC."
  schema_evolution_rule:
    - "Freely add, remove, or restructure keys inside HANDOFF_PAYLOAD as the target ISA, hardware, or abstraction level evolves."

# ==============================================================================
# PART 2: MUTABLE HANDOFF PAYLOAD (EVOLVING Z80 & COMPUTER CONTEXT)
# ==============================================================================
HANDOFF_PAYLOAD:
  schema_id: "Z80-ISA1-SYSTEM/1.0"

  isa_profile:
    base_family: "Zilog Z80"
    active_variant: "Z80 ISA-1 (Custom R800-Pipelined Core) + Vanilla Z80A Slave"
    isa1_microarchitecture:
      pipeline: "3-stage R800-style pipeline with 16-bit prefetch buffer"
      on_die_sram: "512 x 16-bit (1 KB) zero-wait-state (V) scratchpad SRAM (v  drop-in 4164 (64K/128K) or 41256 (256K/512K) + 0x7FFD paging"
      pcb_topology: "Cut-ready corridor separating CPU/ULA from ROM/DRAM; later sheared and clamped via screw-mounted elastomeric/spring compression interposer (M2.5/M3 asymmetric brass screws carry GND and +5V)"
    io_ports:
      - port: "0xFE"
        notes: "Vanilla ULA border/keyboard/EAR/MIC + Read Bit 5 = Z80_SLAVE hardware ID flag"
      - port: "0x7F"
        notes: "ROM_EXTRA / DRAM bank toggle & VPP programming arm control"
      - port: "0x7FFD"
        notes: "Future-proof 16 KB bank-paging, shadow-screen flip, and Z80_SLAVE private page select"

  machine_state:
    tracking_mode: "ABSTRACT"
    master:
      registers:
        main: { AF: "0x0000", BC: "0x0000", DE: "0x0000", HL: "0x0000" }
        alt:  { AF_: "0x0000", BC_: "0x0000", DE_: "0x0000", HL_: "0x0000" }
        idx:  { IX: "0x5C3A", IY: "0x5C3A", SP: "0xFFFF", PC: "0x0000" }
        sys:  { I: "0x00", R: "0x00", IM: 1, IFF1: 0, IFF2: 0 }
    slave:
      registers:
        main: { AF: "0x0000", BC: "0x0000", DE: "0x0000", HL: "0x0000" }
        alt:  { AF_: "0x0000", BC_: "0x0000", DE_: "0x0000", HL_: "0x0000" }
        idx:  { IX: "0x5BE0", IY: "0x5C3A", SP: "0x5BFE", PC: "0x0000" }
        sys:  { I: "0x00", R: "0x00", IM: 1, IFF1: 0, IFF2: 0 }
      mailbox:
        SLAVE_BASIC_PTR: "0x5BFA (2 bytes)"
        SLAVE_PC: "0x5BFC (2 bytes)"
        SLAVE_CTRL: "0x5BFF (0x00=Idle, 0x01=MachineCode, 0x02=BASIC_OFFLOAD)"

  session_context:
    established_decisions:
      - "Evicted 8+8 (16-bit) DRAM path on base board to stay within 16-chip cost; kept 8-bit AD[7:0] odd-even crossbar."
      - "4.000 MHz system clock (256T/line) + 7.000 MHz vanilla pixel dot clock + 4.433619 MHz PAL chroma crystal."
      - "Plain 2T ULA DRAM reads into external 2x74LS373 ping-pong latches (32B attribute cache evicted as redundant)."
      - "Dual-Z80 shared-ROM architecture: Z80_SLAVE identifies via IN A,(0xFE) Bit 5, steals Z80_MASTER internal bus holes via /WAIT, supports BASIC OFFLOAD."
      - "Memory map: 0x0000-0x3FFF Mask ROM, 0x4000-0x7FFF ROM_EXTRA (2x8K 2764 sockets + $0.85 NE555 burner), 0x8000-0x9AFF screen, 0x9B00-0xFEFF free RAM (~25.5 KB), VARS/stack at RAMTOP."
      - "Cut-ready PCB corridor with screw-clamped compression interposer (GND/VCC via asymmetric brass screws) and MA8 Pin-1 routing for 1985 4164/41256 upgrades."
    open_questions: []
    artifacts_in_flight:
      - "Complete 256-entry ISA-1 Main Opcode Table (copiable TSV format)"

  next_action:
    objective: "Finalize and output the complete 256-entry ISA-1 Main Opcode Table in copiable TSV format."
    constraints: "Preserve META_SPEC verbatim on future checkpoints; align opcode timings with 1T on-die SRAM / 2T crossbar model."
