      early_grant_preskew: "0.5Q (35.24 ns) early /EARLY_GRANT assertion before VDP Q3 ends via 14.19 MHz dual-edge vernier"

  VDP_section:
    clocks_and_pal_raster:
      master_crystal_mhz: 14.18758 # 1Q = 70.48 ns, 0.5Q = 35.24 ns
      pixel_clocks_mhz:
        - "14.18758 MHz (2X hi-res mode, 4 px/T)"
        - "7.09379 MHz (1X square-pixel standard, 2 px/T)"
        - "3.546895 MHz (0.5X half-width / low-bandwidth mode, 1 px/T, 15.625 kHz PAL sync preserved)"
      pal_frame_timing:
        line_duration_us: 64.00
        line_cycles_t: 227.0 # 160-184T active + 0.5-24.5T border + 42.5T H-blank
        field_lines: 312.5 # 240-288 active + 24.5-72.5 V-blank/border
        field_cycles_t: 70937.5 # 50.00 Hz PAL field (141,875T per 25 Hz frame)
      fullscreen_1to1_presets:
        # FRAME_SIZE[1:0] presets (Width/2 = exact integer 1.0T DRAM turns per visible scanline)
        "00": { res: "320x240p / 640x480i", active_t: 160, blank_t: 67, tiles_8x8: "40x30", role: "Standard safe area" }
        "01": { res: "352x264p / 704x528i", active_t: 176, blank_t: 51, tiles_8x8: "44x33", role: "CRT-bezel fullscreen (CCIR-601/VCD width, 1:1 square px)" }
        "10": { res: "360x270p / 720x540i", active_t: 180, blank_t: 47, tiles_8x8: "45x33.75", role: "Exact 4:3 aspect" }
        "11": { res: "368x288p / 736x576i", active_t: 184, blank_t: 43, tiles_8x8: "46x36", role: "Max PAL active overscan" }

    ula_48dip_tiled_blitter_partition:
      silicon_target:
        package: "48-pin PDIP (Ferranti ULA5C000 / ULA6C000)"
        populated_gates: "~680 gates (~56% of 1,200-1,400 gate array; single-pass autoroute, high wafer yield)"
        power_and_thermal: "~305 mW total (~280 mW core @ 7.09/3.55 MHz + ~25 mW 14.19 MHz vernier) + low-profile extruded Al DIP heatsink (theta_JA ~25-30 C/W)"
        die_economics: "Full 5C/6C die perimeter needed for 48 pads; 56% population eliminates Issue-1 Spectrum overheating and cuts NRE/yield loss"
      ula_14mhz_edge_skew_vernier:
        clock_mhz: 14.18758
        step_ns: 35.24 # 0.5Q dual-edge vernier (~30 ULA gates)
        functions:
          - "/EARLY_GRANT crossbar handover alignment"
          - "/RAS, /CAS, and t_RP precharge DDS DRAM strobe shaping"
          - "Sub-pixel SCX and 640px (2X) dot phase alignment"
      external_msi_chips:
        - { part: "4x 74LS161 / 74F161", qty: 4, role: "12-bit CMD_PTR[11:0] (0x000-0xFFF 4,096B wrap) + H/V COL[5:0] raster counters (saves ~210 ULA gates)" }
        - { part: "1x 74F157", qty: 1, role: "Blitter SRC/DST byte-transparency merge & X_OFF DATA_L<->DATA_H byte-swap mux" }
        - { part: "1x 74LS374", qty: 1, role: "RGB555 high-byte pixel latch" }
      ula_index_sram:
        device: "1x 2114 (1024x4 static RAM, 120ns)"
        pin_interface: "6 ULA pins (ULA_SD[3:0], ULA_LE_SA, /ULA_SRAM_WE); SA[9:4] driven directly by external 74LS161 COL[5:0], SA[1:0]=nibble phase"
        prefetch_cadence: "1Q (70.48ns)/nibble pipelined H-blank CHAR prefetch on Y_LINE%8==0 (40-45T total, once per 8 lines); leaves 768x4 nibbles (384B) free"

    legacy_and_direct_rgb_modes:
      legacy_reference_modes:
        mode_0: "8x8i text/tile (80x60 or 40x60), coupled [CHAR, ATTR], 2KB font @ 0x4000"
        mode_1a: "8x16i text/tile (80x30 or 40x30), coupled [CHAR, ATTR], 4KB font @ 0x4000 (4,800B screen)"
        mode_1b: "16x16i super-tile (20x30), 16b CHAR (32,512 glyphs) + 16b ATTR + 16b GLYPH in 3 DDS turns (+1 free)"
        mode_2: "Raw 640x480i 1bpp linear bitmap (4,800B ATTR @ 0x0000 + 38,400B bitmap @ 0x12C0)"
        mode_3: "8x2bpp LRGB4 tile (320x480i), ATTR[15:0] = 4x 4b LRGB palette"
        mode_4: "Direct 4-bit LRGB linear (320x480i @ 80 turns/line, 640x480i @ 160 turns/line)"
        mode_5: "Direct RGB332 linear/tiled (320x480i @ 160 turns/line)"
        mode_6: "RGB565 tile cell (140x480i / 160x480i)"
      stripped_48dip_tiled_color_tiers:
