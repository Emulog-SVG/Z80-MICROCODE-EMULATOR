    target_era: "1982-1983"
    design_philosophy: "Minimum-gate/FET bipolar CDI ULA + commodity 74F/74LS MSI + zero-contention 16-bit DDS DRAM crossbar"

  isa1_cpu_core:
    clock_mhz: 3.546895 # 1T = 281.94 ns (14.18758 MHz / 4)
    datapath_width: "8-bit ALU + 16-bit Address/Pointer ADDER + 16-bit AW (A:W) shift latch"
    memory_interface:
      dram_access: "1.0T (281.94 ns) per 16-bit DDS turn (80 contention-free turns/line in 50/50 interleave)"
      sram_opcache: "0WS local SRAM instruction cache (sram_pc) + CATCH opcache allowing full-speed execution during VDP burst lines"
    alu_and_adder_features:
      south_alu: "8-bit logic/arith, nibble shifter (RLC/RRC/SHLC/SHRC), NIBREV, 16-bit CY/AW shift buffer"
      north_adder: "16-bit pointer increment/offset + hardware block engine (LDIR/FILL) for fast display-list & memory moves"

  bus_arbitration:
    topology: "Odd-Even 2T 16-bit DDS DRAM Crossbar (AD[7:0] + A8/A9, DATA_L/DATA_H)"
    turns_per_pal_line: 227 # 227.0T @ 3.546895 MHz = 64.00 us
    interleave_modes:
      balanced_50_50: "80 VDP turns + 80 CPU turns across 160T active safe area (88+88 in 352px, 90+90 in 360px, 92+92 in 368px)"
      vdp_burst: "Up to 160-184 VDP turns during active scanline for high-bpp direct RGB modes; CPU runs from 0WS SRAM opcache"
      idle_blitter_priority: "VDP_BEAM_REQ > ULA_BLIT_REQ > IDLE (blitter runs strictly in unused VDP turns; 0 CPU stall, 0 beam snow)"
