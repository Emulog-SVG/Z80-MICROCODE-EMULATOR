        tier_1_4bpp: { format: "4-bit RGBI (1111, 16 direct colors, 0x0=transparent)", turns_per_8px_row: 2, max_res_50_50: "320x240p (80 turns)", max_res_burst: "368x288p (92 turns)" }
        tier_2_8bpp: { format: "8-bit 2222 LRGB (LL_RR_GG_BB) / RGB332 (256 direct colors, 0x00=transparent)", turns_per_8px_row: 4, max_res_50_50: "160x240p (80 turns)", max_res_burst: "352x264p (176 active turns, ~45.5 avg free H-blank turns/line)" }
        tier_3_12bpp: { format: "12-bit RGB444 (4,096 colors: 1px/word w/ 4b T/PRIO/BLEND flags @ 8 turns, or 3-nibble packed 4px/3words @ 6 turns)", turns_per_8px_row: "6 or 8", max_res_burst: "208x240p (6T) / 160x240p (8T)" }
        tier_4_16bpp: { format: "16-bit RGB555+T (32,768 colors, bit15=transparent so 0x0000 black stays usable)", turns_per_8px_row: 8, max_res_50_50: "80x240p (80 turns)", max_res_burst: "160x240p (160 turns)" }

    bounded_scroll_and_clipping:
      scx_horizontal: "SCX[7:0]: low 3 bits select 0..7px tap on pixel serializer; upper 5 bits add coarse tile column offset"
      v_skip_vertical: "V_SKIP[7:0]: down-counter loaded at VSYNC; emits BORDER color & suppresses active DDS fetches for top N lines"
      guard_band_curtain: "H_MARGIN[7:0] & V_MARGIN[7:0]: programmable 4-edge border-mask window (eliminates NES-style edge pop-in during 8-way scroll & enables 50fps iris/curtain wipes)"

    idle_turn_tile_imprint_blitter:
      purpose: "Hardware tile-into-tile sprite compositor running strictly in idle VDP DDS turns"
      free_turn_budget: "~23,021 free DDS turns per 50 Hz field (~46,042 turns per 25 Hz frame) even in 352x264p 8-bit burst mode"
      command_ring: "4,096-byte ring buffer (512 descriptors x 8B, 12-bit hardware counter wrap)"
      descriptor_layout_8b:
        bytes_0_1: "SRC_ADDR[15:0] (source sprite tile row pointer)"
        bytes_2_3: "DST_TILE_ADDR[15:0] (scratch dynamic tile buffer in FONT_BASE)"
        bytes_4_5: "MAP_CELL_ADDR[15:0] (target tilemap cell patched atomically on final turn)"
        byte_6: "OFF_BYTE (X_OFF / Y_OFF alignment)"
        byte_7: "CFG_BYTE (control / end-of-list 0x00 / optional ROW_MASK[7:0])"
      execution_sequence: "4 turns (8B descriptor fetch) + 32 x [RD_SRC, RD_DST, WR_MERGED] (96 turns, 0x00=transparent) + 1 turn (atomic MAP_CELL patch) = 101 turns/tile"
      throughput: "227 full 64-byte (8x8 256-color) tiles per 50 Hz field (~25 full 16x16 3x3-tile sprites @ 50Hz, ~51 @ 25Hz)"

