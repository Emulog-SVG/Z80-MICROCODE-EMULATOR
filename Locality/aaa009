col_E: "[LD (SP):AO:AL+,PCH, LD (SP):AO:AL+,PCL, LD (AL):AO:AL+,H, LD (AL):AO:AL+,L, SADDLD AB,PCL, SADDLDCARRY AA,PCH, LD:DF APC:AO,AA:AB, SYS IFF1=IFF2, LD AB,0x66, ---, ---, EX DE,HL, ---, ---, ---, ---]"
col_F: "[LD WZ:AO,AA:AB, NOPLD WZ:AO:AL:APC, NOPLD WZ:AO:AL:HL, DI, LD WZ:AO,LH:LL, NOPLD HL:AO:AL:SP, LD APC:AO,WZ, SYS IM=0/1/2, LD WZ:AO,0x0066, ---, ---, EI, ---, ---, ---, ---]"
