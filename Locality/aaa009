hardware_architecture:
ula_silicon: "Dedicated Ferranti 5C/6C ULA (~1,140 gates used of ~1,200-1,400; legacy 0xFE I/O, tape EAR/MIC, and scrambled bitmap logic removed)"
package: "40-pin PDIP (13p DDS crossbar + 6p 2114 Index SRAM + 9p RGB332/CSYNC + 4p clk/pwr/rst + 8p spare/MMIO/coder ctrl)"
video_output: "8-bit RGB332 (R[2:0], G[2:0], B[1:0] resistor DAC) + /CSYNC + BURST_DIS feeding external TEA2000 / MC1377 PAL TV-coder & RGB SCART"
ula_index_sram:
chip: "1x 2114-12 (1024x4, 120ns) quad-series nibble SRAM (6 ULA pins: ULA_SD[3:0], ULA_LE_SA, /ULA_SRAM_WE)"
timing: "0.5T (140.97ns) per nibble = 2T per 16b CHAR_CODE; pre-reads 40x 16b indices (160 nibbles = 40T) inside a single 42.5T H-blank at Y_FIELD=7"
display_geometry:
active_safe_area: "320 x 240p (or 320 x 480i interlaced)"
borders_pal: "24px L/R (3.42us each) + 24 lines T/B inside 368x288 visible PAL raster (total CRT overscan safety; consumer TVs lack horizontal width knobs)"
