djnz_rel: "0x10 (3.0T not-taken / 4.0T taken): [1] LD:W DL,(PC:AO:AL+) -> [2] (wait) -> [3] LD:WAIT LL,(AL:AO:PC+) | DECLD AA,B -> [4] (wait) | LD B,AA -> [5] LD:DF:W Z DL,(PC:AO:AL+) | SADD LL,PCL>AA -> [6] SADD CY,PCH>AB -> [7] LD:W DL,(AB|AA:AO:PC+)"
