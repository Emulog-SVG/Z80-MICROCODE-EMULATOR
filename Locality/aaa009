col_5: "[LD D,B, LD D,C, LD D,LL, LD D,E, LD D,H, LD D,L, LD D,LR, LD D,A, LD E,B, LD E,C, LD E,D, LD E,LL, LD E,H, LD E,L, LD E,LR, LD E,A]"
col_6: "[LD H,B, LD H,C, LD H,D, LD H,E, LD H,LL, LD H,L, LD H,LR, LD H,A, LD L,B, LD L,C, LD L,D, LD L,E, LD L,H, LD L,LL, LD L,LR, LD L,A]"
col_7: "[LDAO LL,(BC), LDAO LL,(DE), LDAO LL,(HL), LDAO LL,(AW), LDAO LL,(IX), LDAO LL,(IY), ---, ---, LD A,B, LD A,C, LD A,D, LD A,E, LD A,H, LD A,L, LD A,LR, LD A,LL]"
