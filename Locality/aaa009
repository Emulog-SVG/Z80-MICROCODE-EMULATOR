emulator_trace_ref:
source: "Locality/NMOS & VZ80REMIX transistor-level NMOS Z80 simulator (3.546895MHz half-T settled logs)"
key_findings:
- "Standard operand read = 3.0T (845.81ns): ULAT opens transparent DLATCH at T2 rising (281.94ns), /WAIT sampled at T2 falling (422.91ns), DLATCH closes at T3 rising (563.87ns)"
- "HALT trace (2/0..4/1) proves ULAT/ULATO is a level-sensitive transparent pass-gate resampling DB on every rising edge while UWAIT loops on /WAIT=0; SIGEXEC=0 & BUSRQ/BUSAK granted until INT/NMI"
- "ADDER=input/addr-out latch (ADDR=ADDER on x/0), ADDES=ripple output latch (NOPLD/INCLD/DECLD/INCLD7 on x/0, reg commit on x/1)"
- "LD (nn),A merges W = A | F at 5/1 (UPCDWQ), overwrites W = A at 13/1 (ULWA), leaving WZ=(A<<8)|((nn+1)&0xFF); LD A,(nn) leaves WZ=nn+1; IN A,(n) uses 5H /IORQ (15/1..18/1) & leaves WZ=((A<<8)|n)+1"
- "CALL cc,nn late-tests cc at 12/1 wasting 13/0..14/1 on false cc (replaced by 2.0T !OCC early-cancel in ISA-1)"
- "ADD/ADC/SBC HL,RR runs 2x 8b ALU passes & writes WZ=HL+1; RLD/RRD uses NIBB-REV-BUS; IM0/1/2 & NMI suppress PC inc via NOPLD"
isa1_microarch:
pipeline: "3-stage R800-style pipeline + 16b prefetch buffer; 4b sliced ALU (16b in 2T, 32b in 4T, 16x16->32 MUL ~16T & 32/16->16 DIV ~16-20T); distributed Phi1/PHI2 6T latches at D[7:0] pad ring"
bus_dual_pc: "dram_pc (1MB linear ext bus via DDS full-mux AD[7:0]+A8/A9); sram_pc (0WS 16b Local SRAM/opcache); V = 0WS SRAM window ptr; XJP n / XJP (V) / XRET"
dds_bus_timing:
master_clock: "14.18758 MHz PAL crystal (1Q=70.48ns, 0.5Q=35.24ns, 1H=140.97ns, 1T=281.94ns)"
read_1T: "Q0..Q2 (211.45ns) parallel 16b DRAM fetch into 2x 74F543 (DATA_L/H) -> Q3 (70.48ns) DDS_L (35.24ns) + DDS_H (35.24ns) on AD[7:0]"
write_1T: "Q0 (70.48ns) DDS_L + DDS_H -> Q1..Q3 (211.45ns) ROW/COL + Early Write (/WE_L/H before /CAS)"
write_to_read_guard: "1H (140.97ns) t_RP precharge between consecutive Write->Read cycles"
resig_bus_ctrl:
spec: "v2.0 Autonomous 8-Mode Memory, Bus & RESIG Interface; DRAM_SPD modes: 0=1.0T (-15/-20), 1=1.5T (+2Q high-park for -25), 2=2.0T (+4Q for -30/-37), 3=2.0-3.0T WAIT_SAMPLED; /IORQ window=5H (2.5T)"
cfg_regs: "CFG_SEL 00=CFG_MODE_CTRL | 01=CFG_DMA_PACE | 10=CFG_ROM_SEG (ROM_OVL_EN=1 auto-disarms VIRT_EN)"
eff_modes: "0:IO(5H) | 1:Z80/ROM | 2:8b_Mux_DRAM | 3:24A/16D_Mux | 4:16A/16D_Lin | 5:16b_Mux_DRAM(unified /CAS + /WE_L,/WE_H) | 6:4b_SRAM_2114(2H nib) | 7:Fast_8b_SRAM(1H)"
opcache_capture: "OP_START, OP_LEN, OP_CUR latches; CATCH streams fetched opcodes to SRAM[OP_CUR++]; END captures trailing branch then halts"
loop_accel: "IR/DR, IRLR/DRLR, IRNZ/DRNZ fused w/ Tier-1 ACT_CC"
e_carry: "16b carry/bitfield shift-buffer CY[15:0] (CY==F.C); BEX n binds CY as LR"
dialect: "sjasmplus (standard Zilog mnemonics + ISA-1 pfxs; 0x hex, 0b binary)"
z80_baseline: "Vanilla Z80 baseline assumed NMOS w/ undocumented opcodes/flags documented"
virtual_ops:
- "CALL_INT_M2 n | CALL NMI | XLAT LR,A | BSWAP/EZX/ESX/LTOH/HTOL/LLZX/LLSX/MIRR LR | FIND0/FIND1 LR,A"
- "LD A,LR / LD LR,A / INC LR / DEC LR / LD LR,n / LD LR,nn / JP (LR)"
- "STACK_DEPTH n / STACK_FLUSH / STACK_FETCH | BEX n / PEX LR,n | SET_OP_CUR n / CATCH / END"
regs_banks:
banks: "4 banks EXX0..3 (0xCA/DA/EA/FA); per-bank {AW,BC,DE,HL,IX,IY,SP,V,F} evicted to 0WS 16b SRAM"
link_reg: "LR (16b internal link/scratch reg: LR0=lo, LR1=hi)"
last_reg_2: "LAST_REGISTER_2 (LR2): arises ONLY via MEM*+MEM* mixture or EXTEND (V) pfx"
sp_binding: "All stack ops bind permanently to EXX0.SP in SRAM"
m1_pipeline:
model: "Stateless M1 pfx latch loop + 8x16b MEM[0..7] macro latches; esc pgs: 0x27=LRPAGE, 0x2F=BITPAGE, 0x3F=BITPAGE$"
tiers: "T1: ACT_CC (0x88..8F) -> T2: REP0..7 (0x98..9F, 9b SHL3) -> T3: fusable MEM[0..7] & modifier stream"
cc8_fixed: "Fixed non-programmable ACT_CC[0..7] = CC8 [NZ,Z,NC,C,PO,PE,P,M]"
rr_shift: "MEM[0..7] replays stored 16b latch; terminal MEMx preceded by >=1 non-MEM* pfx fuses & memorizes 16b state"
shadow_gather: "MEM[0..7] default RR mutation mapped 1:1 to RR8[0..7] (boot SSDEF: AW:L1,BC:R1,DE:X1,HL:XC,IX:L2,IY:R2,SP:X2,V:XC)"
width_rev: "Vanilla widths default; WORD promotes to 16b; WBZ/WBS/WB$/WB$$; REV (0x37) swaps LEFT<->RIGHT"
word_mutation_rules:
root_word: "WORD (0x33): promotes LEFT, RIGHT, DEST to 16b; A/AF->AW; LEFT RRH->RR', RIGHT RRH->RR; 0x76->LD (HL),(DE); 0xC9->RETI; 0xF3->RLD; 0xFB->RRD"
wordrev: "WORDREV (0x37): root_word + REV swap; RIGHT AW->AW'; LEFT nn->(nn); 0xC9->RETN; 6 --- slots"
wordlr: "WORDLR (0x3B): root_word + LEFT RRL->LR, RIGHT RRH->LR, SP->LR"
wordlrrev: "WORDLRREV (0x3F): wordlr + post-apply REV swap"
sticky_rr: "Triggered exclusively by virtual STICK pfx until new MEMy or MODE_"
virtual_pfxs: "STICK | MEMDEF | WB$$ | DEST_LR | EXTEND nn | EXTEND (V) | SATU | SATS"
am_rr_modes: "?[fut] evicted for future task (3b per-reg latch via AM n/LR on LRPAGE)"
ss_rr_modes: "6b per-reg latch via SS n on LRPAGE; 0x27 0xD9=SSDEF"
