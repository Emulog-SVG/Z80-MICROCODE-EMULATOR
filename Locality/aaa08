meta_spec:
  id: LLM-STATE-HANDOVER-v6.0-UNIFIED
  obj: Lossless Z80 ISA-1 & ZX Spectrum 48K handover; bottom-up cascade decode, 0 stored grid variants, 0 invented ops.
  strict:
    no_guess: Never guess ambiguous/incomplete input. If deterministic mapping fails, HALT and ask only missing/ambiguous items (max 3).
    replies: On edits, emit ONLY 1-line ACK (e.g., OK: +pg0 0001xxxx=ADD | FREE -1). On page views ("show main page"->pg1, "show pg0", "show hl_pg"), emit ONLY transposed 16x16 ```tsv (rows=low 0..F, cols=high 0..F; op=(col<<4)|row; no hex headers; gaps=---). 0 prose. Append " | [HANDOVER_REC]" after ~15 edits or ~5 TSV dumps.
    export: Keep meta_spec & isa_state internal on normal turns. On export/handover request, coalesce adjacent FREE masks, prune dead overrides, emit ONLY single unbroken ```yaml block with verbatim meta_spec + compacted isa_state + EOF sentinel; 0 prose before/inside/after.
    ingest: On `CHUNK i/N` or `PART i` (i<N), buffer silently -> reply `ACK i/N`. On `END`, `i==N`, or raw URL load -> merge, audit, reply `READY`. Auto-iterate all entries in `reference_corpora` on session start before ROI/opcode analysis. On empty/404/inaccessible URL, treat accompanying inline text or auto-boxed attachment block (`File: [source: N]...`) as URL payload (no HALT/error).
    compress: Apply terse domain abbrs (pg, def_pg, esc, sw, pfx, op, sem, var, excl, recon, hw) & macro arrays inside isa_state only; keep meta_spec verbatim, pure ASCII, lines <= 115 chars.
    gen_isa: Store ONLY canonical base pages (pg0 + non-derived esc pgs) as bottom-up cascade bit-masks (MASK=MNEM | flags). Define sibling main pgs (pg1..pg3) & RR-prefixed pgs as deterministic mutation rules over pg0; recon on demand via transform rules & !immune locks.
    slots: Track unallocated/evicted patterns per page as FREE / ---. Fill FREE only via user-migrated ops (freeing source) or user-defined ops; 0 auto-fill/invention.
    audit: On writes/exports, internally verify (1) 256/256 deterministic coverage & 0 mask collisions across canonical & derived pages, (2) 4-point RR PLA truth-table invariants (uniform group branch target addressing, active EXX without suffix on mutated (RR+)/(SP)->(RR+), REV/*R/*WR swaps all 2-op LEFT<->RIGHT while leaving 1-op intact, explicit left A on all RR ALU ops), (3) all custom abbrs resolve, (4) `reference_corpora` verbatim preserved & URL-checked. Abort export & ask up to 4 issues on failure.
  exec: Enforce strict; audit on writes & exports.

isa_state:
  arch: Z80 ISA-1 (Custom NMOS Hybrid R800-Pipelined Core + Vanilla Z80A Slave; Z80-EX v7.9.6 lossless ISA root)
  def_pg: pg1 # MODE_V active at reset; pg0 (MODE_Z) is canonical mutation root
  macros:
    R8: [B,C,D,E,H,L,(HL),A]
    RR4: [BC,DE,HL,SP]
    RR8: [AW,BC,DE,HL,IX,IY,SP,V]
    RR_AFFECT16: [AW,BC,DE,HL,IX,IY,SP,(V),LR,EF,PC,(NN),rsvd,rsvd,rsvd,rsvd] # V==(V) vector access
    HALF_RR: {AW: A/W, BC: B/C, DE: D/E, HL: H/L, IX: IXH/IXL, IY: IYH/IYL, SP: S/P, V: VH/VL}
    CC4: [NZ,Z,NC,C]
    CC_EVEN: [PO,PE,P,M]
    CC8: [NZ,Z,NC,C,PO,PE,P,M]
    CC32:
      - [NZ, Z, NC, C, PO, PE, P, M, BE, A, L, GE, LE, G, H, NH] # 0..15 single-step F
      - [ZZ, NZZ, BEZ, AZ, LEZ, GZ, VV, CC] # 16..23 cascaded F + OLD_F (Z_pair = Z & Zp)
      - [OVP, OVN, NC2, C2, CEZ, CNZ, ADD, SUB] # 24..31 saturation, bounds & step-delta
    EXX_BANKS: [EXX0,EXX1,EXX2,EXX3] # explicit 0..3 suffix for targeted banks; omit suffix for active latch
    FLAGS: { "!": "!immune", "?": "[fut]", n: imm8, nn: imm16, dd: rel16, e: rel8 }

  hw_invariants:
    isa1_microarch:
      pipeline: "3-stage R800-style pipeline + 16b prefetch buffer; 4-bit sliced ALU (16b in 2T, 32b AW:BC/HL:DE in 4T, nibble-sliced 16x16->32 MUL ~16T & 32/16->16 DIV ~16-20T); distributed Phi1/PHI2 6T latches at D[7:0] pad ring"
      bus_dual_pc: "dram_pc (64KB ext 8b bus via 0.5T-phased 8+8 byte-sequencer on AD[7:0], 1T Fast Page / 2T row miss); sram_pc (0WS 16b Local SRAM/opcache); V = 0WS SRAM window ptr; XJP n sets SRAM_PC<-(n<<2) & switches fetch to SRAM_PC preserving DRAM_PC; XJP (V) jumps via (V); XRET switches fetch back to DRAM_PC"
      opcache_capture: "OP_START, OP_LEN, OP_CUR latches; CATCH streams fetched opcodes to SRAM[OP_CUR++]; END captures trailing branch inst then halts capture; CATCH/END act as 1T NOP when fetching from SRAM_PC; all branches inside SRAM_PC stay in SRAM_PC until XRET"
      external_word_sram: "4x 2114L-2 (200ns, 1T) or 2114H-1 (120ns, 0.5T) 512x16 (1KB base, scalable to 64KB) on SD[15:0] (40p Pin-21 keyed)"
      loop_accel: "IR performs INC HL+INC DE; DR performs DEC HL+DEC DE; IRLR/DRLR repeat until LAST_REG==0 using active LAST_REG width (8b/16b) and INC/DEC step; IRNZ/DRNZ repeat while Z==0 (NZ) and fuse with Tier-1 ACT_CC to override condition with active CC32 slot"
      e_carry: "16b carry/bitfield shift-buffer CY[15:0] (CY[0]==F.C); updating CY via bitfield ops (e.g. BEX n) binds CY as active LAST_REG for subsequent LR addressing/ops"
      dialect: "sjasmplus (standard Zilog mnemonics + ISA-1 prefixes; 0x hex, 0b binary)"
      z80_baseline: "Vanilla Z80 baseline assumed NMOS with all undocumented opcodes and flags treated as documented"
      virtual_slot_rule: "When a target page has 0 FREE slots, new opcodes/prefixes are added virtually in hw_invariants"
      virtual_ops:
        - "CALL_INT_M2 n: IM2 vectored SW INT via I:n, saves/clears IFF1"
        - "CALL NMI: SW NMI to 0x0066, IFF2<-IFF1, IFF1<-0"
        - "XLAT LR,A: reads byte/word from (RR_last + uint16(A)) -> A, flags unaffected"
        - "BSWAP LR / EZX LR / ESX LR: byteswap hi<->lo / zero-extend lo->hi / sign-extend lo->hi of RR_last"
        - "BEX n: extracts bitfield [n[7:4]+n[3:0]-1 : n[7:4]] from LR into E-CARRY CY[15:0] (binds CY as LR)"
        - "PEX LR,n: deposits low n[3:0] bits of E-CARRY CY[15:0] into RR_last starting at bit n[7:4]"
        - "MIRR LR: autosized 8b/16b bitwise mirror of LAST_REG via zero-gate wire reversal, flags unaffected"
        - "FIND0 LR,A / FIND1 LR,A: lowest 0-bit / 1-bit index of LAST_REG -> A, Z=1 if none"
        - "SET_OP_CUR n: loads OP_CUR SRAM opcache capture pointer"
        - "CATCH / END: start/stop SRAM opcache capture (captures 1 trailing branch after END; NOP in SRAM_PC)"
      tsv_view: "Canonical TSV page view is transposed: rows=low 0..F, cols=high 0..F, op=(col<<4)|row"
    regs_banks:
      banks: "4 banks EXX0..3 selected by 2b latch (0xCA/DA/EA/FA); per-bank {AW,BC,DE,HL,IX,IY,SP,V,F} evicted to 0WS 16b SRAM"
      link_reg: "LR (16b internal link/scratch reg: LR0=lo, LR1=hi, updated on A writes)"
      last_reg_2: "LAST_REGISTER_2 (LR2): init undef; arises ONLY via MEM*+MEM* mixture or EXTEND (V) pfx (never auto-shifted on LR writes; 0 standalone LR2 ops); inherits pre-last LR on pfx fusion; mutates all LEFT ops while last-win pfx mutates HL, H, L, & SP"
      sp_binding: "All stack ops (*CALL,*RET,LDI/LDD (SP),PUSH/POP n,EX (SP),RR,INC/DEC SP) bind permanently to EXX0.SP (1T in SRAM); EXX0..3 switch NEVER switches SP or flushes Stack FIFO (flushes only on EXX0.SP write or (EXX0.SP+d) index)"
    m1_pipeline:
      model: "Stateless M1 pfx latch loop + 8x16b MEM[0..7] macro latches; terminal esc pgs: 0x27=LRPAGE, 0x2F=BITPAGE, 0x3F=BITPAGE$; terminal op inherits T1 ACT_CC guard, T2 R0..7 rep count, & T3 MEM[0..7] RR mutation/affection"
      tiers: "T1: ACT_CC (0x88..8F, main-only infinite skip guard, fuses w/ IRNZ/DRNZ) -> T2: R0..R7 (0x98..9F, main-only 1..8 rep count; w/ RET pops addr then SP+=2*rep_count) -> T3: fusable MEM[0..7] & modifier stream"
      cc32_lut: "8x5b programmable ACT_CC[0..7] LUT indexing CC32[0..31] over (F, OLD_F); reset/CCDEF defaults to 0..7 (CC8); SETCC n (imm8[4:0]) programs active CC slot"
      rr_shift: "MEM[0..7] always replays stored 16b latch (cold-boot & RESET/MEMDEF default = RR8[0..7] + SSDEF); standalone MEMx or MEM*-only chains never overwrite latch; terminal MEMx preceded by >=1 non-MEM* pfx fuses & memorizes 16b state [8b affection (REV[1b], STICK[1b], RR_affection[4b], WORD[1b], 1b rsvd) + 4b LR2 + 4b DEST_RR]; in MEM*+MEM* preceded by modifiers, pre-last MEM* fuses flags & last MEM* memorizes; any two MEM* enable LR2 affection; last-win pfx mutates HL/H/L/SP"
      shadow_gather: "MEM[0..7] default RR mutation mapped 1:1 to RR8[0..7] (AW,BC,DE,HL,IX,IY,SP,V); each RR pfx updates LEFT/RIGHT bank latches via SS<RR> (boot SSDEF: AW:L1, BC:R1, DE:X1, HL:XC, IX:L2, IY:R2, SP:X2, V:XC)"
      width_rev: "Vanilla Z80 operand widths by default; WORD promotes all ops to 16b; WORDB evicted; WBZ: LEFT=16b word, RIGHT=zext16(byte); WBS: LEFT=16b word, RIGHT=sext16(byte); WB$/WB$$: LEFT=16b word, RIGHT=rel8/rel16 (on non-rel ops e.g. LD/ALU, RIGHT is unsigned byte ZX, e.g. LD C,E->LD BC,E; implicit 1-op INC/DEC expand as ALUOP dst,1->dst before mutation; RIGHT (HL)->(HL+$) [AM evicted to ?]; LEFT (HL)->(HL+d); native 16b RIGHT RR truncates ZX to low byte; ,nn & OUT/IN (n) immutable; DJNZ/JR immutable on WB$, promote to dd on WB$$); REV (0x37) or *R/*WR swaps LEFT<->RIGHT after all mutations (1-op intact, auto-clears at retirement)"
      sticky_rr: "Triggered exclusively by virtual STICK pfx (identical consecutive MEMx+MEMx removed as sticky trigger); locks rr_curr, shadow triggers, & width across subsequent insts until new MEMy or MODE_*"
      virtual_pfxs: "STICK (arms sticky mode); MEMDEF (restores MEM[0..7] latches to register-order defaults); WB$$ (LEFT=16b word, RIGHT=rel16); DEST_LR (dst override to LR); EXTEND nn (imm16 direct load of 16b MEM* state, supersedes 8b AFFECT n); EXTEND (V) (loads 16b MEM* state from 0WS SRAM (V) ptr, can activate LR2); SATU / SATS (unsigned / signed ALU saturation, auto-clears at retirement); SETCC n (imm8[4:0] -> CC32 LUT); CCDEF (restores ACT_CC[0..7] to CC8)"
    am_rr_modes: "?[fut] evicted for future task (3b per-reg latch via AM<RR> n/LR on LRPAGE: 0:NONE | 1:+D | 2:+DD | 3:INC | 4:DEC | 5:+HL1 | 6:+HL2 | 7:+HL3)"
Используйте код с осторожностью.
ss_rr_modes: "6b per-reg latch (n[2:0]=LEFT, n[5:3]=RIGHT) via SS n on LRPAGE; codes {0:EXX0, 1:EXX1, 2:EXX2, 3:EXX3, 4:CURR}; 0x27 0xD9=SSDEF"
zx48k_platform:
target: "Custom 1982-1985 PAL50 ZX-Class Unified Computer (ISA-1 Master ~3.45-3.50 MHz + Z80A Slave ~2.15-3.35 MHz, Wide Wedge)"
clocks: "14.18758 MHz crystal -> 7.09379 MHz VDP + 3.546895 MHz CPU (227.0T/line: 160T active, 24.5T border, 42.5T H-blank w/ 9T HSYNC refresh)"
bus_arbitration: "Odd-Even 2T ULA/CPU crossbar; BYTE_MODE=1 gates /CAS_L,/WE_L via /A0 & /CAS_H,/WE_H via A0 for Z80A; SLAVE_BUS_/OE = WAIT_ACT OR NOT /RFSH"
ula_mmio: "40p DIP ULA + 6116-12 (2048x8) SRAM; 0 /IORQ ports; V-blank DMA copies 2,032B attr/palette (lines 307-311); 8 modes (256/320 x 192/240p & 384i/480i), ATTR_4B, 2BPP+4x4 -> SCART + MC1377P; MMIO +0x7F0..7F7 KBD, +0x7F8 ULA_CFG, +0x7F9 BEEPER_MIC, +0x7FA EAR_IN, +0x7FB SYS_STATUS (Bit5=SLAVE_ID)"
memory_map: "0x0000-3FFF Mask ROM/2x2764 (BASIC, Slave Monitor, OFFLOAD parser, NE555 burner) | 0x4000-7FFF ROM_EXTRA (Laser BASIC, CP/M 2.2, Beta Disk) | 0x8000-VRAM_TOP Dynamic VRAM (6,912-21,600B) | VRAM_TOP+1..0xFEFF User RAM (32KB/64KB banked) | 0xFF00-FFFF RAMTOP; Slave mailbox 0x5BFA-5BFF (IX=0x5BE0, SP=0x5BFE)"
enclosure_bom: "155x85mm mother PCB (5 keyed ports) + 120x65mm DRAM PCB + 75x55mm Slave PCB in 335x150x30mm wedge; $40.47-$58.90 BOM -> $119-$169 retail"
fut_discovery: "tri_op_3_operand_alu: when k>=2 RR pfxs stream in M1, pair penultimate latch rr_prev (RIGHT/src2) with final latch rr_curr (LEFT/dst/src1) on 16b ALU/mem-mem ops (rr_curr <- rr_curr op rr_prev)"
