P1_static:
  abbr:
    ADDR_BASE: 8-bit upper page latch for SRAM jump/OPCACHE base {ADDR_BASE, n}
    AW: Auxiliary Word 16-bit pair (AWH/AWL) in Bank 0..3
    BIU: Bus Interface Unit
    LDD: 16-bit pre-dec store (ptr -= 2; (ptr) = ss)
    LDI: 16-bit post-inc load (ss = (ptr); ptr += 2)
    LR: Last Register in LR_PREV[4:0] (8-bit)
    LRP: Last Register Pair in LR_PREV[4:0] (8-bit/16-bit)
    M1: Opcode fetch cycle (M1_1 first byte, M1_2 second byte)
    MODE_V: Triggerless 1B imm V addressing ({VAR_BASE, V << 1} -> 16b Local SRAM word, 0WS, /MREQ=1)
    OPCACHE: Hardware opcode recorder/player in Local SRAM
    RDF: Read Flags F[7:0] -> shadow acc A1/A2/A (0x08 on LEFT/BOTH1/SP RR pages)
    RESIG: Reconfigurable External Signal bus modes M0..M7
    RR: Register/Index page prefix set (BC, DE, HL, SP, AW, DD=IX, FD=IY)
    STACK_FIFO: Hardware ring buffer at top tail of Local SRAM
    UNLK: Unlock sticky LOCK_<RR> mode via <RR>:00
    VAR_BASE: 8-bit upper page latch for (V) Local SRAM variable window {VAR_BASE, V << 1}
    WB: Write-Back result
    WRF: Write Flags F[7:0] <- shadow acc A1/A2 (0x08 on RIGHT/BOTH2 RR pages)
    0WS: Zero Wait States
  topology_mem_latches_modes:
    baseline: Z80/8080 binary-compatible baseline (key_base hex 00-FF; MODE_8080 boot default via 7C-7C; MODE_EXT via 7D-7D; intact 8080 slots preserved; 1/2/3 bank suffixes; LDI/LDD stack ops; AW on rp=3).
    hw_state:
      core: Stripped NMOS control core (<=8500T) + scalable off-die 16-bit Local SRAM (1KB 0000-03FF .. 64KB 0000-FFFF) + 8-mode BIU/RESIG (M0_Z80_STD, M1_SPLIT_BUS, M2_MUX16, M3_WORD16, M4_DUAL_BUS, M5_8080, M6_PACKED_SRAM 0WS /MREQ=1, M7_BUS_HOLD_SRAM_RUN /BUSACK=0).
      on_die_latches: [A, F[15:0], PC, SP, I, R, WZ, PENDING_WB[15:0], LR_PREV[4:0], PREV_M1_OP[7:0], OP_WP[15:0], OP_REC, DEST_SEL[2:0], W16_MODE, REV_MODE, EXCHG_MODE, CARRY_ARMED, ACT_CC[3:0], REP_CNT[5:0], MAIN_BANK_PTR[1:0], SH_LEFT, SH_RIGHT, RR_PTR[2:0], VAR_BASE[7:0], ADDR_BASE[7:0]]
      singletons: SP and WZ are single on-die non-shadowable registers; F[15:0] has F[7:0] flags and F[15:8] reserved.
      sram_map:
        0000-003F: 4 x 16B Reg Banks (Bank0 Main BC,DE,HL,AW + 4 rsv; Bank1 Left BC1,DE1,HL1,AW1,IX1,IY1 + 2 rsv; Bank2 Right BC2,DE2,HL2,AW2 + 4 rsv; Bank3 Alt/ISR BC3,DE3,HL3,AW3 + 4 rsv)
        0040-013F: IM 4 Vector Table (128 x 16b)
        0140-FEFF: Scalable Middle (0140-02FF in 1KB) -> OPCACHE snippets, PACKED code ({ADDR_BASE, n}), (V) vars ({VAR_BASE, V << 1})
        Tail-FFFF: STACK_FIFO Ring Buffer (0300-03FF in 1KB; top tail in 64KB; FIFO_WP, FIFO_RP, pow2 FIFO_MASK)
      mechanisms:
        pending_wb: Clean unpfx Main LD r1,r2 (40-7F, excl (V) ops [46, 56, 66, 74, 76, 77, 7E]; 70-73 & 75 defer (V) WB) holds WB in PENDING_WB at M1_1; if M1_2 == M1_1, discard WB and exec DUAL_ISSUE (~14T). Preceding pfx inhibits DUAL_ISSUE.
        rr_lifecycle: <RR> = ONCE | <RR><RR> = LOCK_<RR> | <RR>:00 = UNLK.
        mode_v: Main Page (nn)/(HL) slots use MODE_V; 01=LD BC,(V), 11=LD DE,(V), 21=LD HL,(V), 31=LD SP,(V).
        chat_table_fmt: Display any 256-entry opcode page outside handover YAML as raw 16x16 TSV (no header/index, col-major 00..0F col 1 .. F0..FF col 16).
  primary_page_overrides:
    excl: [7C-7C=MODE_8080, 7D-7D=MODE_EXT]
    ops:
      - 00=WORD | 16b pair mode, +-2 stride (00xx_0000)
      - 08=DEST_BC | WB -> BC/C/B (00xx_1000)
      - 10=REV | swap dst/src (00xx_0000)
      - 18=DEST_DE | WB -> DE/E/D (00xx_1000)
      - 20=WORDREV | WORD + REV (00xx_0000)
      - 27=UNALLOC | unallocated on Main Page
      - 28=DEST_AW | WB -> AW/AWL/AWH (00xx_1000)
      - 30=EXCHG | X_MAIN transform on next op (00xx_0000)
      - 38=DEST_V | WB -> SRAM word (V) (00xx_1000)
      - 3F=INCINC_REPNZ | +2/+2 stride + REPNZ
      - 40=BC_PFX | LEFT2 BC
      - 49=DE_PFX | RIGHT2 DE
      - 52=HL_PFX | BOTH1 HL
      - 5B=SP_PFX | CLEAN SP bridge
      - 64=AW_PFX | BOTH2 AW
      - 6D=DD_PFX | LEFT1 IX
      - 76=LD (DE),(V) | HALT at 4F-4F
      - 7F=FD_PFX | RIGHT1 IY
      - 88..8F=ACT_CC | single-op predication (NZ,Z,NC,C,PO,PE,P,M)
      - 98..9F=R0..R7 | 0..63x internal replay w/o M1
      - A8..AF=SET_LR r | LR_PREV <- r/V (1010_1nnn; SUB A=0x97 clears A+CY)
      - B0..B7=CLR r | r <- 0x00 / (V) <- 0x0000, 0 flags (1011_0nnn; AND A=0xA7 tests A)
      - C1/D1/E1/F1=LDI ss,(SP) | BC, DE, HL, AW
      - C5/D5/E5/F5=LDD (SP),ss | BC, DE, HL, AW
      - C7=NEG A
      - CB=Super-CB | 3B prefix CB <op> <imm>
      - CF=MUL8 | multi-cycle shift-add
      - D7=BSWAP HL
      - D9=LR_PFX | self-chaining LR_PREV right-op ovrd
      - DD=CARRY | arms CY/Borrow for next ADD/SUB
      - DF=NEG16 HL
      - E0=LD A,(HL)
      - E2=LD (HL),A
      - E3=LD (DE),(HL)
      - E4=INC (HL)
      - E7=LD HL,(SP) | non-inc peek
      - E8=DEC (HL)
      - E9=NOP | JP (HL) at F7
