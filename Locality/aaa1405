      unified_rdata_bus: "Orthogonal dual 8b byte-DDS RDATA_L/H[7:0] + shared 8b ADDR_DDS[7:0] + direct 8b ALU_OUT->LH:LL"
      reg_skew_budget: "0.25T mux: Q0 SP->ADDER (AO 25-35ns dir / 55-70ns rip), Q1 R->RDATA->LH:LL (85-95ns; +15..65ns t_AS)"
      dio_buf_pad_slice: "Distributed 4b/pad DIO_BUF[0..3] (16 FETs/pad) inside AD0..7 pad cells; ~1.5-2.5ns capture skew"
    byte_dds_core_fabric:
      scope: "Global across ISA-1 & RISC core inter-block transfers (zx48k_platform excluded)"
      octal_t_only: "All on-die DDS transfers & pad-ring DDS_L/H muxes run strictly at sync 0.5Q (35.24ns); 1Q for compute"
      tds_on_die_mode: "3-beat Triple-Data-Strobe (AOL->AOH->EAO) on-die DDS mode; external RAMs stay QDS/DDS/SDS"
      orthogonal_polarity: "Hardwired ADDER<>REGS=L->H & REGS<>ALU=H->L (0 swap FETs, 0 bank collisions); AL/AO/APC->AB_H:AB_L"
      signaling: "Source-synchronous sender-skewed bundled strobe (DATA_STB / ALU_STB); local 0.5Q pass-gate seams"
      reg_pla_sequencer: "Main PLA issues (SP+d)/(IX+d)/(RR+); Reg PLA sequences TMP_L->RR_L->RR_H + SIGN_EXT (~85-115ns)"
      freq_scaling: "3.55MHz: 0.5Q=35.24ns (4/1H); 4-6MHz: latch-to-latch DDS stays 0.5Q (20.8-31.25ns), carry scales to 1Q"
    two_tier_stall_and_clock_gating:
      short_1q_to_4q: "Synchronous 14.18758MHz OR-gate CPU_CLK high-park BEFORE Phi1/Phi2 gen (70.48ns steps, <=2000ns)"
