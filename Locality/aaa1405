meta_spec:
  id: LLM-STATE-HANDOVER-v6.0-UNIFIED
  obj: Lossless Z80 ISA-1 & ZX Spectrum 48K handover; bottom-up cascade decode, 0 stored grid variants, 0 invented ops.
  strict:
    no_guess: Never guess ambiguous/incomplete input. If deterministic mapping fails, HALT and ask only missing/ambiguous items (max 3).
    replies: On edits, emit ONLY 1-line ACK (e.g., OK: +pg0 0001xxxx=ADD | FREE -1). On page views ("show main page"->pg1, "show pg0", "show hl_pg"), emit ONLY transposed 16x16 ```tsv (rows=low 0..F, cols=high 0..F; op=(col<<4)|row; no hex headers; gaps=---). 0 prose. Append " | [HANDOVER_REC]" after ~15 edits or ~5 TSV dumps.
    fut_capture: Scan session context on every export; auto-flush all unbound assumptions, tentative microarch ideas, & unallocated concepts into isa_state.future_tasks as terse key-summary entries (deduped, 0 prose); promote to hw_invariants/pg0 only on explicit commit.
    export: Keep meta_spec & isa_state internal on normal turns. On export/handover request, run fut_capture, coalesce adjacent FREE masks, prune dead overrides, emit ONLY single unbroken ```yaml block with verbatim meta_spec + compacted isa_state + EOF sentinel; 0 prose before/inside/after.
    ingest: On `CHUNK i/N` or `PART i` (i<N), buffer silently -> reply `ACK i/N`. On `END`, `i==N`, or raw URL load -> merge, audit, reply `READY`. Auto-iterate all entries in `reference_corpora` on session start before ROI/opcode analysis. On empty/404/inaccessible URL, treat accompanying inline text or auto-boxed attachment block (`File: [source: N]...`) as URL payload (no HALT/error).
    compress: Apply terse domain abbrs (pg, def_pg, esc, sw, pfx, op, sem, var, excl, recon, hw) & macro arrays inside isa_state only; keep meta_spec verbatim, pure ASCII, lines <= 115 chars.
    gen_isa: Store ONLY canonical base pages (pg0 + non-derived esc pgs) as bottom-up cascade bit-masks (MASK=MNEM | flags). Define sibling main pgs (pg1..pg3) & RR-prefixed pgs as deterministic mutation rules over pg0; recon on demand via transform rules & !immune locks.
    slots: Track unallocated/evicted patterns per page as FREE / ---. Fill FREE only via user-migrated ops (freeing source) or user-defined ops; 0 auto-fill/invention.
    audit: On writes/exports, internally verify (1) 256/256 deterministic coverage & 0 mask collisions across canonical & derived pages, (2) 4-point RR PLA truth-table invariants (uniform group branch target addressing, active EXX without suffix on mutated (RR+)/(SP)->(RR+), REV/*R/*WR swaps all 2-op LEFT<->RIGHT while leaving 1-op intact, explicit left A on all RR ALU ops), (3) all custom abbrs resolve, (4) `reference_corpora` verbatim preserved & URL-checked. Abort export & ask up to 4 issues on failure.
  exec: Enforce strict; audit on writes & exports.

isa_state:
  arch: Z80 ISA-1 (Custom NMOS Hybrid R800-Pipelined Core + Vanilla Z80A Slave; Z80-EX v7.9.6 lossless ISA root)
  def_pg: risc_main_page # primary canonical opcode breakage root; non-primary grids retired to future_tasks
  reference_corpora:
    - "https://githubusercontent.com"
    - "https://githubusercontent.com"
  clocks:
    master_osc_mhz: 14.18758 # 1Q=70.484ns, 0.5Q=35.242ns (octal-T DDS), 1H=140.968ns, 1T=281.936ns (3.546895MHz)
    vdp_px_mhz: 7.09379 # primary 320px TV/comp clk (140.97ns/px); 14.18758MHz for 640px RGB SCART / BURST_DIS
    pal_raster: "227.0T/line (160T active 45.11us + 24.5T border + 42.5T H-blank); 312.5 lines/field 50Hz PAL"
    hierarchy: "1T(281.94ns) / 1H(140.97ns) / global 1Q(70.48ns carry/ALU) / local dual-edge 0.5Q(35.24ns octal-T)"
  macros:
    R8: [B,C,D,E,H,L,(HL),A]
    RR3: [BC,DE,HL]
    RR4: [BC,DE,HL,SP]
    RR8: [AW,BC,DE,HL,IX,IY,SP,V]
    SETLR_RR: [AW,BC,DE,HL,IX,IY,SP,F]
    SETLR_IND: [(BC),(DE),(HL),(LR)]
    SETLR_IDX: [(IX+d),(IY+d),(SP+d),(LR+d)]
    RR_AFFECT16: [AW,BC,DE,HL,IX,IY,SP,(V),LR,EF,PC,(NN),rsvd,rsvd,rsvd,rsvd] # V==(V) vector access
    HALF_RR: {AW: A/W, BC: B/C, DE: D/E, HL: H/L, IX: IXH/IXL, IY: IYH/IYL, SP: S/P, V: VH/VL}
    CC4: [NZ,Z,NC,C]
    CC_EVEN: [PO,PE,P,M]
    CC8: [NZ,Z,NC,C,PO,PE,P,M]
    CC32:
      - [NZ, Z, NC, C, PO, PE, P, M, BE, A, L, GE, LE, G, H, NH] # 0..15 single-step F
      - [ZZ, NZZ, BEZ, AZ, LEZ, GZ, VV, CC] # 16..23 cascaded F + OLD_F (Z_pair = Z & Zp)
      - [OVP, OVN, NC2, C2, CEZ, CNZ, ADD, SUB] # 24..31 saturation, bounds & step-delta
    EXX_BANKS: [EXX0,EXX1,EXX2,EXX3] # explicit 0..3 suffix for targeted banks; omit suffix for active latch
    FLAGS: { "!": "!immune", "?": "[fut]", n: imm8, nn: imm16, dd: rel16, e: rel8 }

  hw_invariants:
    process_baseline:
      tech: "1976-1979 3.0-4.0 um NMOS-I default (1981-1983 2.0-2.5 um NMOS-II / HMOS-II optional shrink; 1975-78 8080/6502/8086 dynamic C_gs + precharged bus precedent)"
      timing: "NMOS-I tau ~1.5-2.5ns, R_on ~2-4k, blind clock-driven precharge (0-10ns) + 3T C_gs evaluate (10-35.24ns) inside 0.5Q=35.24ns; C_gs hold ~0.5-2ms @ 70C; NMOS-II tau 0.4-1.0ns, 80-125MHz DDS ceiling"
      thermal: "<1.0W PDIP-40 (0.85-1.0W target; theta_JA ~45-55 C/W; 2.0-3.2mA perimeter pin super-buffers)"
      clk_stopped_leakage_osc: "~25-FET missing-pulse C_wd detector + temp-tracking junction-leakage relaxation osc keeping 3T dynamic C_gs cells refreshed when master clock stops (0 bus arbitration needed)"
    least_tr_solution:
      base_evolution: "Vanilla Z80 main pg is lowest-TR root; evolve by evicting low-ROI ops then migrating pfxs"
      word_vanilla_mutation_test: "WORD pfx family originally applied over vanilla Z80 main pg as root"
      virtual_first_allocation: "All new ISA ops/pfxs added first as virtual defs before physical slot binding"
      lr_latch_mutation: "Single LR latch tracks parent RR pair + addr mode of last DEST; mutates explicit LR ops"
      aw_accumulator_pair: "16b accumulator pair AW (A:W) pairs existing 8b A with companion byte W"
      ef_extended_flags: "16b extended flags pair EF pairs existing 8b F with companion byte E / OLD_F"
      old_f_history_latch: "Single-byte OLD_F latch captures prior F on flag updates for cascaded (F, OLD_F)"
      nibble_alu_16b_2t: "4b sliced ALU executes 16b ALU ops in 2T (1T+1T two-phase nibble pipeline)"
      e_carry_16b: "16b carry/bitfield shift-buffer CY[15:0] (CY==F.C); binds CY as LR"
      mode_v_window: "MODE_V (pg1 default reset) rewrites non-! {(HL),(nn),nn} operands to 0WS SRAM window ptr (V)"
      word_prefix: "WORD pfx promotes 8b operands across target ops to 16b word width on 2T nibble ALU"
      act_cc_fixed: "Hardwired ACT_CC[0..7] skip-guard fixed to CC8; fast-skip advances PC past trailing bytes"
      rep0_7_9b_fuse: "REP0..REP7 chained pfxs shift 9b repeat latch left by 3 bits (0..511 repeats)"
      external_sram_1024b: "4x 2114-12 (512x16=1KB) or 2x 6116-12 (4KB), scalable to 64KB; 74ALS373/74F573 Phi1 latch"
      stack_fifo: "Hardwired to EXX0.SP at SRAM_TOP; spills 4B/burst to DRAM; STACK_DEPTH/FLUSH/FETCH"
      stack_fifo_memcpy: "STACK_FETCH at src SP then STACK_FLUSH at dst SP performs zero-CPU-loop bulk memcpy"
      push_pop_lr_bind: "PUSH/POP RR sets LR to pushed/popped RR; 0xF1=POP LR, 0xF5=PUSH LR"
    reg_cache_lfu:
      slots_6x16b_12B: "12B (6x16b=96b) split BANK_L/H register cache holding active {BC,DE,HL,IX,IY,V} + 3b saturating (0..7) LFU aging (~185 FETs) & 20b {EXX1:0,RR_ID2:0} FIFO_SHL5 shadow tags (~125 FETs); SP/PC in ADDER, AW/EF in ALU"
      cell_3t_dyn_reread: "Plain 3T addressable dynamic C_gs cells (288 cell FETs for 96b, ~348 total block FETs, 0 static DC power); non-destructive 0.5Q reads via blind clock-driven RDATA_L/H precharge (0-10ns) + evaluate (10-35.24ns); 2-beat 1Q (70.48ns) split RD_SEL->RDATA latch->WR_SEL scrub (0..5 counter every ~48-64T) & opportunistic post-read WB"
      sram_backing: "1Q/nibble external 64x4 SRAM (82S21/AM27S03 or 2114) backs EXX1..3 shadow banks + 2-word (8-nibble) AW'/EF' slot (~220-260 FETs saved, 1.0T atomic EX AF,AF' swap); 0-cycle EXX tag mutation"
    zero_gap_bitslice_floorplan:
      layout: "2D Whole-Die Distributed-PLA (~14mm2, ~2.8-3.1k core FETs saved): West=Cycler/DIO_BUF, North=ADDER+E+PC/SP/ADDER_PLA, Center=Reg/REG_PLA, South=ALU+AW/EF/ALU_PLA, East=16b Cracker/MAIN_PLA"
      reg_banks: "6x16b 3T dynamic BANK_L (bit 0..7: C,E,L,IXL,IYL,VL + LR0) & BANK_H (bit 8..15: B,D,H,IXH,IYH,VH + LR1); SPL/PCL/WZL & SPH/PCH/WZH in North ADDER; W/A & F/OLD_F in South ALU"
